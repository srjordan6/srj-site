---
// AI Movers and Shakers hub: one card per person, alphabetical.
import BaseLayout from '../../../layouts/BaseLayout.astro';
const mods = import.meta.glob('../../../content/people/*.json', { eager: true });
const entries = Object.entries(mods);
const full = entries.filter(([k]) => !k.endsWith('roster.json')).map(([, m]: any) => m.default ?? m);
const rosterMod: any = entries.find(([k]) => k.endsWith('roster.json'))?.[1];
const roster = rosterMod ? (rosterMod.default ?? rosterMod) : { people: [] };
const slugify = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const have = new Set(full.map((p: any) => p.name));
const stubs = roster.people.filter((r: any) => !have.has(r.name)).map((r: any) => ({
  slug: slugify(r.name), name: r.name, moniker: r.title, org: r.org, stub: true,
}));
const people = [...full, ...stubs].sort((a: any, b: any) => a.name.localeCompare(b.name));
---
<BaseLayout title="AI Movers and Shakers | AI Resources | SRJ Consulting & Services" description="The movers and shakers in the world of AI: one-page profiles with legacy, achievements, timelines, and sources.">
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><a href="/ai-resources/">AI Resources</a></p>
      <h1>AI Movers and Shakers</h1>
      <p class="lede">The movers and shakers in the world of AI.</p>
    </div>
  </section>
  <section class="grid-wrap">
    <div class="container">
      <div class="grid">
        {people.map((p: any) => (
          <a class="card" href={`/ai-resources/ai-people/${p.slug}/`}>
            <h2>{p.name}</h2>
            <p class="moniker">{p.moniker}</p>
            {p.stub
              ? <p class="span">{p.org}</p>
              : <p class="span">{p.born}&ndash;{p.died ?? 'Present'} · {p.nationality}</p>}
            {!p.stub && <p class="fields">{p.fields.join(' · ')}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { padding: 100px 0 60px; background: linear-gradient(180deg, var(--cream), var(--white)); }
  .eyebrow a { color: var(--orange); text-decoration: none; }
  .lede { font-size: 21px; color: var(--ink-soft); font-style: italic; }
  .grid-wrap { padding: 20px 0 110px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 22px; }
  .card { display: block; border: 1px solid #e6e4de; border-radius: 10px; padding: 24px 26px; text-decoration: none; background: var(--white); transition: box-shadow .18s ease, transform .18s ease; }
  .card:hover { box-shadow: 0 10px 28px rgba(32,24,104,.12); transform: translateY(-2px); }
  .card h2 { font-family: Lora, serif; font-size: 21px; color: var(--navy); margin: 0 0 4px; }
  .moniker { color: var(--orange); font-weight: 600; font-size: 13.5px; margin: 0 0 10px; line-height: 1.4; }
  .span, .fields { font-size: 13.5px; color: var(--gray); margin: 0 0 4px; }
</style>
