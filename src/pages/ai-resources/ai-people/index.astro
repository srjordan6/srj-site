---
// AI People hub: the movers and shakers, one verified profile each.
import BaseLayout from '../../../layouts/BaseLayout.astro';
const mods = import.meta.glob('../../../content/people/*.json', { eager: true });
const people = Object.values(mods).map((m: any) => m.default ?? m)
  .sort((a: any, b: any) => a.name.localeCompare(b.name));
---
<BaseLayout title="AI People | AI Resources | SRJ Consulting & Services" description="The movers and shakers in the world of AI. Verified one-page profiles: legacy, achievements, timelines, and primary sources.">
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><a href="/ai-resources/">AI Resources</a></p>
      <h1>AI People</h1>
      <p class="lede">The movers and shakers in the world of AI.</p>
    </div>
  </section>
  <section class="grid-wrap">
    <div class="container">
      <div class="grid">
        {people.map((p: any) => (
          <a class="card" href={`/ai-resources/ai-people/${p.slug}/`}>
            <h2>{p.name}</h2>
            <p class="moniker">{p.moniker}</p>
            <p class="span">{p.born}&ndash;{p.died ?? 'Present'} · {p.nationality}</p>
            <p class="fields">{p.fields.join(' · ')}</p>
          </a>
        ))}
      </div>
      <p class="note">Every profile is compiled against the primary sources listed on its page. Profiles are added as they are verified.</p>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { padding: 100px 0 60px; background: linear-gradient(180deg, var(--cream), var(--white)); }
  .eyebrow a { color: var(--orange); text-decoration: none; }
  .lede { font-size: 21px; color: var(--ink-soft); font-style: italic; }
  .grid-wrap { padding: 20px 0 110px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 22px; }
  .card { display: block; border: 1px solid #e6e4de; border-radius: 10px; padding: 24px 26px; text-decoration: none; background: var(--white); transition: box-shadow .18s ease, transform .18s ease; }
  .card:hover { box-shadow: 0 10px 28px rgba(32,24,104,.12); transform: translateY(-2px); }
  .card h2 { font-family: Lora, serif; font-size: 22px; color: var(--navy); margin: 0 0 4px; }
  .moniker { color: var(--orange); font-weight: 600; font-size: 14px; margin: 0 0 10px; }
  .span, .fields { font-size: 13.5px; color: var(--gray); margin: 0 0 4px; }
  .note { margin-top: 34px; font-size: 14px; color: var(--gray); font-style: italic; }
</style>
