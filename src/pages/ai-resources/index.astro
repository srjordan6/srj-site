---
// The AI Resources hub: srjconsultingservices.com/ai-resources/
// Everything below this layer per the July 27 IA decision, with one
// exception fixed by the same decision: /ai-governance/ stays at root
// and is featured here as the flagship card.
//
// TWO SECTIONS, matching the structure of the WordPress /resources/ page:
// "Free AI Tools" for the reference material the practice maintains, and
// "Reading and Updates" for the things a visitor reads rather than looks up.
// The WordPress page had both; the first version of this hub had only the
// first, which left Insights, the newsletter, the press kit and the FAQ with
// no route in from the Resources hub at all.
//
// NO NEW URLS. Every href below already exists and already answers 200. Six
// point at pages the replatform built (/ai-resources/*), five at pages in the
// 138-URL production inventory (/ai-governance/, /ai-governance/sources/,
// /insights/, /newsletter/, /press/, /faq/). Nothing here invents a path or
// contradicts the site tracker: a card is a route in, not a new destination.
import BaseLayout from '../../layouts/BaseLayout.astro';
import FreeAIResources from '../../components/FreeAIResources.astro';

const freeTools = [
  // Flagship card. Renamed July 31, 2026 from "AI Governance Reference
  // Library" to "The AI Lawsuit & Policy Hub" when the AI Lawsuit Database
  // shipped alongside the library: one destination, two halves, so the card
  // carries a link to each. Rendered separately below because sub-links
  // cannot nest inside the <a> the other cards use.
  {
    href: '/ai-governance/',
    title: 'The AI Lawsuit & Policy Hub',
    desc: 'Laws, regulations, standards, and enforcement, maintained against primary sources, alongside active AI lawsuits tracked against live court dockets. The flagship: 60+ pages, 82,000+ words.',
    live: true,
    flagship: true,
    links: [
      { href: '/ai-governance/', label: 'AI Governance' },
      { href: '/ai-governance/ai-lawsuits/', label: 'AI Legal Cases' },
    ],
  },
  // Cards below the flagship run A to Z, matching the Free AI Resources index
  // ordering (Stephen's July 31, 2026 ruling).
  {
    href: '/ai-resources/ai-glossary/',
    title: 'AI Glossary',
    desc: '522 terms across governance, security, and operations, defined in plain business English.',
    live: true,
    note: 'Each term with a worked example and, where citable, its origin.',
  },
  {
    href: '/ai-resources/ai-people/',
    title: 'AI Movers and Shakers',
    desc: 'The movers and shakers in the world of AI: verified one-page profiles with legacy, achievements, timelines, and primary sources.',
    live: true,
    note: 'Profiles added as they are verified.',
  },
  {
    href: '/ai-resources/ai-news/',
    title: 'AI News',
    desc: 'What\u2019s happening in the world of AI: the day\u2019s top stories ranked by breadth of global coverage, each with its own page and sources.',
    live: true,
    note: 'Refreshed every morning by the pipeline.',
  },
  // Replaced the AI News Events card, which duplicated AI News: both promised
  // "what happened recently" and a reader could not tell which to click.
  // Sources is the opposite of news and the better companion to it, the
  // primary-document layer that news coverage is explicitly NOT admissible
  // against.
  {
    href: '/ai-governance/sources/',
    title: 'AI Sources',
    desc: 'The primary documents behind the library: statutes, regulator publications, and standards, linked to the actual text rather than an issuing body\u2019s homepage.',
    live: true,
    note: 'Press is inadmissible as evidence here.',
  },
  {
    href: '/ai-resources/ai-tools/',
    title: 'AI Tools',
    desc: 'The 320-tool catalog: vendors, categories, home jurisdictions, and verified official URLs for the AI tools market.',
    live: true,
    note: 'Per-tool profiles added as they are verified.',
  },
  // Renamed from "Everything else AI" July 31, 2026: the intel feed is
  // vendor announcements, so the card now says what the section is.
  {
    href: '/ai-resources/ai-vendor-news/',
    title: 'AI Vendor News',
    desc: 'Announcements straight from the AI vendors themselves, gathered daily from their own feeds and linked to the original source.',
    live: true,
    note: 'Refreshed daily by the pipeline.',
  },
];

// Things a visitor reads rather than looks up. All four are existing pages in
// the production inventory; this section is a route in, not a relocation.
const readingAndUpdates = [
  {
    href: '/insights/',
    title: 'Insights',
    desc: 'Field notes from active client engagements, framework analysis, and the reasoning behind the operating discipline.',
    live: true,
  },
  {
    href: '/newsletter/',
    title: 'The AI Operating System\u2122 Newsletter',
    desc: 'Biweekly framework analysis, new templates, and field notes. No software pitches.',
    live: true,
    note: 'Free, unsubscribe anytime.',
  },
  {
    href: '/press/',
    title: 'Press and Media Kit',
    desc: 'Bios, company fact sheet, and brand assets, generated on demand.',
    live: true,
  },
  {
    href: '/faq/',
    title: 'Frequently Asked Questions',
    desc: 'Direct answers on how the practice works, what an engagement looks like, and where AI governance obligations actually bite.',
    live: true,
  },
];
---
<BaseLayout
  title="AI Resources | SRJ Consulting & Services"
  description="The SRJ AI resource collection: the AI Governance Reference Library, AI glossary, verified AI news, people, sources, and tools, plus insights and the newsletter."
>
  <section class="hub-hero">
    <div class="container">
      <p class="eyebrow">The Collection</p>
      <h1>AI Resources</h1>
      <p class="lede">
        One place for everything the practice publishes: governance law, definitions, verified
        news, the people and dates that matter, and the tools market. Collected as widely as
        possible, published only when verified.
      </p>
    </div>
  </section>

  <section class="container hub-section cols">
  <div class="main-col">
    <h2 class="sec-head">Free AI Tools</h2>
    <div class="grid">
      {freeTools.map((s) => (
        s.links ? (
          <div class={`card ${s.flagship ? 'flag' : ''}`}>
            <h3><a class="card-title-link" href={s.href}>{s.title}</a></h3>
            <p>{s.desc}</p>
            {s.live ? <span class="badge live">Live</span> : <span class="badge">Coming online</span>}
            <span class="card-links">
              {s.links.map((l) => <a class="card-link" href={l.href}>{l.label} &rarr;</a>)}
            </span>
          </div>
        ) : (
          <a class={`card ${s.flagship ? 'flag' : ''}`} href={s.href}>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            {s.live ? <span class="badge live">Live</span> : <span class="badge">Coming online</span>}
            {s.note && <span class="note">{s.note}</span>}
          </a>
        )
      ))}
    </div>
  </div>
  <aside class="side-rail"><FreeAIResources current="" /></aside>
  </section>

  <section class="container hub-section">
    <h2 class="sec-head">Reading and Updates</h2>
    <div class="grid">
      {readingAndUpdates.map((s) => (
        <a class="card" href={s.href}>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          {s.live ? <span class="badge live">Live</span> : <span class="badge">Coming online</span>}
          {s.note && <span class="note">{s.note}</span>}
        </a>
      ))}
    </div>
  </section>

</BaseLayout>
<style>
  .cols { display: grid; grid-template-columns: minmax(0,1fr) 320px; gap: 44px; align-items: start; }
  .main-col { min-width: 0; }
  .side-rail { position: sticky; top: 20px; }
  @media (max-width: 960px) { .cols { grid-template-columns: 1fr; } .side-rail { position: static; } }
  .hub-hero { background: linear-gradient(180deg, var(--cream), var(--white)); padding: 84px 0 48px; border-bottom: 1px solid var(--line); margin-bottom: 48px; }
  .lede { max-width: 68ch; font-size: 19px; color: var(--ink-soft); margin: 0; }

  /* Section heading. Small caps and an orange rule rather than a large serif
     title: these label two groups within one page, and at h1 weight they would
     compete with the page title for what the page is about. */
  .hub-section { margin-bottom: 52px; }
  .sec-head {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
    margin: 0 0 6px;
  }
  .sec-head::after {
    content: '';
    display: block;
    width: 44px;
    height: 3px;
    background: var(--orange);
    margin-top: 10px;
    margin-bottom: 26px;
  }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 22px; }
  .card { display: block; padding: 26px; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; background: var(--white); transition: box-shadow .15s ease, transform .15s ease; }
  .card:hover { box-shadow: var(--shadow-card); transform: translateY(-2px); }
  .card.flag { border: 2px solid var(--orange); grid-column: 1 / -1; background: linear-gradient(135deg, var(--cream), var(--white)); }
  .card h3 { font-size: 20px; margin-bottom: 8px; }
  .card-title-link { color: inherit; text-decoration: none; }
  .card-title-link:hover { color: var(--orange); }
  .card-links { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 12px; }
  .card-link { font-family: Poppins, sans-serif; font-size: 14px; font-weight: 600; color: var(--navy); text-decoration: none; }
  .card-link:hover { color: var(--orange); }
  .card p { font-size: 14.5px; color: var(--ink-soft); margin: 0 0 14px; }
  .badge { display: inline-block; font-size: 11.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--gray); border: 1px solid var(--line); padding: 3px 10px; border-radius: 20px; margin-right: 10px; }
  .badge.live { color: var(--white); background: var(--orange); border-color: var(--orange); }
  .note { display: inline-block; font-size: 12.5px; color: var(--gray); }
</style>
