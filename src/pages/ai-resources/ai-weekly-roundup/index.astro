---
// AI Weekly Roundup: the week's verifiable movement in AI governance, assembled
// from the same two data families the pipeline refreshes every day - tracked
// lawsuit dockets (lawsuits/lawsuits.json, from ai_lawsuits) and the intel feed
// (intel/intel.json, from ai_intel_candidates).
//
// Everything on this page is derived from the data. Counts are counted, dates
// are the dates in the record, and every item links to its primary source. No
// item is summarized, ranked editorially, or characterized beyond what the
// record itself says. Sections with nothing in the window say so rather than
// padding, which is what makes the page trustworthy week over week.
//
// The window is seven days ending on the newest record in the data, not on the
// build clock, so a stale build shows a truthful older week instead of an
// empty page.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FreeAIResources from '../../../components/FreeAIResources.astro';
import { itemList, faqPage, collectionPage } from '../../../lib/pageSchema';

type Item = {
  kind: string; name: string; vendor: string | null; url: string | null;
  summary: string | null; source: string; discovered_at: string;
};
type Case = {
  slug: string; case_name: string; court: string; docket: string;
  status: string; status_badge: string; category: string;
  latest_development: string | null; latest_development_date: string | null;
  courtlistener_url: string | null; defendants: string | null;
};

const intelMods = import.meta.glob('../../../content/intel/intel.json', { eager: true });
const caseMods = import.meta.glob('../../../content/lawsuits/lawsuits.json', { eager: true });
const intelDoc: any = Object.values(intelMods)[0]?.default ?? null;
const caseDoc: any = Object.values(caseMods)[0]?.default ?? null;

const allItems: Item[] = (intelDoc?.items ?? []).map((i: any) => ({ ...i }));
const allCases: Case[] = (caseDoc?.cases ?? []).map((c: any) => ({ ...c }));

const day = (s: string | null | undefined) => (s ? String(s).slice(0, 10) : '');
const toTime = (s: string) => { const t = Date.parse(s + 'T00:00:00Z'); return isNaN(t) ? 0 : t; };

// Window: seven days ending on the newest date present in either data family.
const dates = [
  ...allItems.map((i) => day(i.discovered_at)),
  ...allCases.map((c) => day(c.latest_development_date)),
].filter(Boolean).sort();
const endDay = dates.length ? dates[dates.length - 1] : '';
const endTime = endDay ? toTime(endDay) : 0;
const startTime = endTime - 6 * 86400000;
const inWindow = (d: string) => { const t = toTime(d); return t > 0 && t >= startTime && t <= endTime; };
const startDay = endDay ? new Date(startTime).toISOString().slice(0, 10) : '';

const fmt = (d: string) => {
  const dt = new Date(d + 'T00:00:00Z');
  return isNaN(dt.getTime())
    ? d
    : dt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
};
const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

// 1. Legal: tracked cases whose docket moved inside the window.
const movedCases = allCases
  .filter((c) => inWindow(day(c.latest_development_date)))
  .sort((a, b) => day(b.latest_development_date).localeCompare(day(a.latest_development_date)));

// 2. Announcements and coverage from the intel feed, grouped by source.
const windowItems = allItems
  .filter((i) => inWindow(day(i.discovered_at)))
  .sort((a, b) => day(b.discovered_at).localeCompare(day(a.discovered_at)));
const papers = windowItems.filter((i) => i.kind === 'paper');
const news = windowItems.filter((i) => i.kind !== 'paper');

const bySource = new Map<string, Item[]>();
for (const it of news) {
  const v = (it.vendor || 'Other sources').replace(/\s*\(coverage\)$/i, '');
  if (!bySource.has(v)) bySource.set(v, []);
  bySource.get(v)!.push(it);
}
const sources = [...bySource.entries()]
  .map(([name, list]) => ({ name, slug: slugify(name), list }))
  .sort((a, b) => b.list.length - a.list.length || a.name.localeCompare(b.name));

const activeCases = allCases.filter((c) => /active/i.test(c.status_badge || c.status || '')).length;

// Deterministic summary: counts and names only, nothing editorialized.
const summaryParts: string[] = [];
if (movedCases.length) {
  summaryParts.push(
    `${movedCases.length} of the ${allCases.length} tracked AI lawsuits recorded docket movement`
  );
} else if (allCases.length) {
  summaryParts.push(`none of the ${allCases.length} tracked AI lawsuits recorded docket movement`);
}
if (news.length) {
  summaryParts.push(
    `${news.length} announcements and reports arrived from ${sources.length} ${sources.length === 1 ? 'source' : 'sources'}`
  );
}
if (papers.length) summaryParts.push(`${papers.length} research papers matched a tracked organization`);
const summary = summaryParts.length
  ? `In the seven days ending ${fmt(endDay)}, ${summaryParts.join(', ')}. ` +
    `Every entry below links to its primary source, and the counts are measured from the ` +
    `records themselves rather than estimated.`
  : '';

const SITE = 'https://srjconsultingservices.com';
const url = `${SITE}/ai-resources/ai-weekly-roundup/`;
const title = 'AI Weekly Roundup: What Changed in AI Governance | SRJ';
const description =
  'What changed in AI governance this week: docket movement in tracked AI lawsuits, ' +
  'announcements from AI labs and regulators, and new research, each linked to its primary source.';

const faqs = [
  {
    q: 'What counts as a change worth reporting?',
    a: 'Three things, and only three: movement on the docket of a lawsuit already in the AI ' +
       'Lawsuit Database, a new announcement or report from a watched lab, vendor, or regulator, ' +
       'and a new research paper from a tracked organization. If none of those happened, the ' +
       'section says so. A quiet week is reported as a quiet week.',
  },
  {
    q: 'How is this assembled?',
    a: 'Automatically, from the same records that drive the AI Lawsuit Database and the AI ' +
       'Vendor News feed. The pipeline refreshes court dockets and reads its watched sources ' +
       'daily; this page reports the last seven days of that record. Nothing is rewritten and ' +
       'nothing is added by hand.',
  },
  {
    q: 'Is an item here verified?',
    a: 'A docket entry is a court record and is reported as filed. An announcement is the ' +
       'source\u2019s own claim about itself, which is a lead, not evidence. Anything that ' +
       'graduates into the AI Governance Reference Library, the AI Tools Directory, or the AI ' +
       'Glossary is verified independently first.',
  },
  {
    q: 'How often does it update?',
    a: 'The underlying data refreshes every day, so the seven-day window moves forward daily ' +
       'and the page always reports the most recent week the data covers.',
  },
];

const schema = [
  collectionPage({ url, name: 'AI Weekly Roundup', description }),
  itemList({
    url,
    name: 'AI governance developments this week',
    description,
    items: [
      ...movedCases.slice(0, 25).map((c) => ({
        name: c.case_name,
        url: `${SITE}/ai-governance/ai-lawsuits/${c.slug}/`,
        description: `Docket movement recorded ${fmt(day(c.latest_development_date))} in ${c.court}.`,
      })),
      ...news.slice(0, 25).map((it) => ({
        name: it.name,
        url: it.url || url,
        description: `${(it.vendor || 'Source').replace(/\s*\(coverage\)$/i, '')}, ${fmt(day(it.discovered_at))}.`,
      })),
    ],
  }),
  faqPage(url, faqs),
];

const generated = intelDoc?.generated ? new Date(intelDoc.generated) : null;
const stamp = generated ? `${generated.toUTCString().slice(0, 22)} UTC` : null;
---
<BaseLayout title={title} description={description} schema={schema} crumbName="AI Weekly Roundup">
  <section class="hero">
    <div class="container">
      <h1>AI Weekly Roundup</h1>
      <p class="dateline">
        <strong>What changed in AI governance</strong>
        {endDay && <> · week ending {fmt(endDay)}</>}
        {stamp && <> · data refreshed {stamp}</>}
      </p>
      <div class="pills" aria-label="Sections">
        <span class="pill-label">This week</span>
        <a class="pill" href="#legal">Legal {movedCases.length > 0 && <>({movedCases.length})</>}</a>
        <a class="pill" href="#announcements">Announcements {news.length > 0 && <>({news.length})</>}</a>
        <a class="pill" href="#research">Research {papers.length > 0 && <>({papers.length})</>}</a>
      </div>
    </div>
  </section>

  <section class="body">
    <div class="container cols">
      <div class="main">
        {!endDay && (
          <div class="empty">
            <p>This week's data has not landed yet. The
            <a href="/ai-governance/ai-lawsuits/">AI Lawsuit Database</a> and
            <a href="/ai-resources/ai-vendor-news/">AI Vendor News</a> carry the full record
            in the meantime.</p>
          </div>
        )}

        {summary && (
          <div class="answer" id="summary">
            <p class="answer-label">The week in one paragraph</p>
            <p>{summary}</p>
          </div>
        )}

        <!-- 1. Legal -->
        <section class="cat" id="legal">
          <h2>Legal developments {movedCases.length > 0 && <span class="count">{movedCases.length}</span>}</h2>
          <p class="cat-blurb">
            Docket movement in the tracked AI lawsuits, as recorded in the court record.
            <a class="section-link" href="/ai-governance/ai-lawsuits/">Full lawsuit database &rarr;</a>
          </p>
          <div class="rule"></div>
          {movedCases.length === 0 ? (
            <p class="quiet">No tracked case recorded docket movement in this window. All
            {' '}{allCases.length} cases remain under watch and are re-checked daily.</p>
          ) : (
            <ul class="feed">
              {movedCases.map((c) => (
                <li>
                  <p class="item-name">
                    <a href={`/ai-governance/ai-lawsuits/${c.slug}/`}>{c.case_name}</a>
                  </p>
                  <span class="item-meta">
                    {fmt(day(c.latest_development_date))} · {c.court}
                    {c.status_badge && <> · {c.status_badge}</>}
                  </span>
                  {c.latest_development && <p class="item-sum">{c.latest_development}</p>}
                  {c.courtlistener_url && (
                    <a class="src" href={c.courtlistener_url} rel="noopener nofollow" target="_blank">Court record &rarr;</a>
                  )}
                </li>
              ))}
            </ul>
          )}
        </section>

        <!-- 2. Announcements -->
        <section class="cat" id="announcements">
          <h2>Announcements and reports {news.length > 0 && <span class="count">{news.length}</span>}</h2>
          <p class="cat-blurb">
            What the watched labs, vendors, and regulators published this week, in their own words.
            <a class="section-link" href="/ai-resources/ai-vendor-news/">Full vendor feed &rarr;</a>
          </p>
          <div class="rule"></div>
          {news.length === 0 ? (
            <p class="quiet">No new announcements landed in this window.</p>
          ) : (
            sources.map((s) => (
              <div class="src-group">
                <h3 id={s.slug}>{s.name} <span class="count-sm">{s.list.length}</span></h3>
                <ul class="feed">
                  {s.list.slice(0, 8).map((it) => (
                    <li>
                      <p class="item-name">
                        {it.url
                          ? <a href={it.url} rel="noopener nofollow" target="_blank">{it.name}</a>
                          : it.name}
                      </p>
                      <span class="item-meta">{fmt(day(it.discovered_at))}</span>
                      {it.summary && <p class="item-sum">{it.summary}</p>}
                    </li>
                  ))}
                </ul>
                {s.list.length > 8 && (
                  <p class="more-note">{s.list.length - 8} more from {s.name} this week in the
                  {' '}<a href="/ai-resources/ai-vendor-news/">full feed</a>.</p>
                )}
              </div>
            ))
          )}
        </section>

        <!-- 3. Research -->
        <section class="cat" id="research">
          <h2>Research {papers.length > 0 && <span class="count">{papers.length}</span>}</h2>
          <p class="cat-blurb">
            New papers on arXiv from the tracked research organizations.
          </p>
          <div class="rule"></div>
          {papers.length === 0 ? (
            <p class="quiet">No papers from a tracked organization matched this window.</p>
          ) : (
            <ul class="feed">
              {papers.slice(0, 15).map((it) => (
                <li>
                  <p class="item-name">
                    {it.url
                      ? <a href={it.url} rel="noopener nofollow" target="_blank">{it.name}</a>
                      : it.name}
                  </p>
                  <span class="item-meta">{it.vendor} · {fmt(day(it.discovered_at))}</span>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="faq" id="faq">
          <h2>Frequently asked questions</h2>
          <div class="rule"></div>
          {faqs.map((f) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </section>

        <p class="note">
          A quiet week is reported as a quiet week. Where a development touches a law,
          framework, or requirement, the authoritative treatment lives in the
          <a href="/ai-governance/">AI Governance Reference Library</a>, and the full case
          record lives in the <a href="/ai-governance/ai-lawsuits/">AI Lawsuit Database</a>.
        </p>
      </div>

      <aside class="side">
        <FreeAIResources current="roundup" />
        <div class="panel sticky">
          <p class="box-label">On this page</p>
          <ul class="toc">
            <li><a href="#summary">The week in one paragraph</a></li>
            <li><a href="#legal">Legal developments</a></li>
            <li><a href="#announcements">Announcements and reports</a></li>
            <li><a href="#research">Research</a></li>
            <li><a href="#faq">FAQ</a></li>
          </ul>
        </div>

        <div class="panel">
          <p class="box-label">Week in numbers</p>
          <table class="dash">
            <tbody>
              {startDay && endDay && <tr><th scope="row">Window</th><td>{startDay} to {endDay}</td></tr>}
              <tr><th scope="row">Cases with movement</th><td>{movedCases.length}</td></tr>
              <tr><th scope="row">Cases tracked</th><td>{allCases.length}</td></tr>
              <tr><th scope="row">Active litigation</th><td>{activeCases}</td></tr>
              <tr><th scope="row">Announcements</th><td>{news.length}</td></tr>
              <tr><th scope="row">Sources reporting</th><td>{sources.length}</td></tr>
              <tr><th scope="row">Research papers</th><td>{papers.length}</td></tr>
            </tbody>
          </table>
          <p class="dash-note">
            Counts are measured from the published records for the window shown, not estimated.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 60px 0 30px; background: linear-gradient(180deg, var(--cream), var(--white)); }
  .dateline { color: var(--gray); font-size: 14px; letter-spacing: .02em; }
  .dateline strong { color: var(--navy); }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 12px; }
  .pill-label { font-family: Poppins, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--orange); margin-right: 4px; }
  .pill { display: inline-block; background: #201868; color: #fff; font-family: Poppins, sans-serif; font-size: 12px; padding: 4px 12px; border-radius: 999px; text-decoration: none; }
  .pill:hover { background: var(--orange); }

  .body { padding: 10px 0 110px; }
  .cols { display: grid; grid-template-columns: minmax(0,1fr) 300px; gap: 44px; align-items: start; }
  @media (max-width: 960px) { .cols { grid-template-columns: 1fr; } }

  .box-label { font-family: Poppins, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--orange); margin: 0 0 10px; }

  .empty { background: var(--cream); border: 1px solid #F0D6B0; border-radius: 6px; padding: 26px; font-family: Poppins, sans-serif; font-size: 15px; line-height: 1.7; }
  .empty a { color: var(--orange); text-decoration: none; }

  .answer { background: #FFF6EC; border: 1px solid #F0D6B0; border-radius: 6px; padding: 22px 26px; margin: 0 0 32px; }
  .answer p { font-family: Poppins, sans-serif; font-size: 16px; line-height: 1.75; color: #2C2C2A; margin: 0; }
  .answer-label { font-size: 11px !important; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #F07800; margin: 0 0 8px !important; }

  .cat { margin: 0 0 44px; scroll-margin-top: 80px; }
  .cat h2 { font-family: Lora, serif; font-size: 25px; color: #201868; margin: 0 0 2px; font-weight: 600; }
  .cat .count { font-family: Poppins, sans-serif; font-size: 13px; color: #fff; background: var(--orange); border-radius: 999px; padding: 2px 9px; vertical-align: middle; margin-left: 6px; }
  .count-sm { font-family: Poppins, sans-serif; font-size: 12px; color: var(--gray); font-weight: 500; margin-left: 4px; }
  .cat-blurb { font-family: Poppins, sans-serif; font-size: 13.5px; color: var(--gray); margin: 0 0 8px; }
  .section-link { color: var(--navy); text-decoration: none; font-weight: 600; margin-left: 6px; }
  .section-link:hover { color: var(--orange); }
  .rule { width: 56px; height: 3px; background: #F07800; margin: 0 0 20px; }
  .quiet { font-family: Poppins, sans-serif; font-size: 15px; line-height: 1.7; color: #2C2C2A; background: #fafaf6; border: 1px solid #e6e4de; border-radius: 6px; padding: 16px 18px; margin: 0; }

  .src-group { margin: 0 0 26px; }
  .src-group h3 { font-family: Poppins, sans-serif; font-size: 15px; font-weight: 700; color: var(--navy); margin: 0 0 2px; scroll-margin-top: 80px; }

  .feed { list-style: none; margin: 0; padding: 0; }
  .feed li { padding: 12px 0; border-bottom: 1px solid #EFE6D8; }
  .feed li:last-child { border-bottom: 0; }
  .item-name { font-family: Poppins, sans-serif; font-size: 15px; font-weight: 600; color: var(--navy); margin: 0; overflow-wrap: anywhere; }
  .item-name a { color: var(--navy); text-decoration: none; }
  .item-name a:hover { color: var(--orange); }
  .item-meta { font-family: Poppins, sans-serif; font-size: 12.5px; color: var(--gray); }
  .item-sum { font-family: Poppins, sans-serif; font-size: 14px; line-height: 1.6; color: #1A1A2E; margin: 4px 0 0; }
  .src { font-family: Poppins, sans-serif; font-size: 12.5px; color: var(--navy); text-decoration: none; font-weight: 600; }
  .src:hover { color: var(--orange); }
  .more-note { font-family: Poppins, sans-serif; font-size: 13px; color: var(--gray); margin: 8px 0 0; }
  .more-note a { color: var(--navy); }

  .side { display: flex; flex-direction: column; gap: 20px; }
  .panel { border: 1px solid #e6e4de; border-radius: 10px; padding: 18px 20px; background: #fafaf6; }
  .sticky { position: sticky; top: 20px; }
  .toc { list-style: none; margin: 0; padding: 0; }
  .toc li { margin: 0 0 7px; }
  .toc a { font-family: Poppins, sans-serif; font-size: 13.5px; color: var(--navy); text-decoration: none; }
  .toc a:hover { color: var(--orange); }
  .dash { width: 100%; border-collapse: collapse; }
  .dash th, .dash td { font-family: Poppins, sans-serif; font-size: 13.5px; padding: 7px 0; border-bottom: 1px solid #eceae4; text-align: left; }
  .dash th { color: var(--gray); font-weight: 500; }
  .dash td { color: var(--navy); font-weight: 700; text-align: right; }
  .dash tr:last-child th, .dash tr:last-child td { border-bottom: none; }
  .dash-note { font-family: Poppins, sans-serif; font-size: 12px; line-height: 1.5; color: var(--gray); margin: 10px 0 0; font-style: italic; }

  .faq { margin: 46px 0 0; scroll-margin-top: 80px; }
  .faq h2 { font-family: Lora, serif; font-size: 25px; color: #201868; margin: 0 0 4px; font-weight: 600; }
  .faq-item { padding: 16px 0; border-bottom: 1px solid #EDEBE5; }
  .faq-item:last-child { border-bottom: none; }
  .faq-item h3 { font-family: Lora, serif; font-size: 19px; font-weight: 700; color: #201868; margin: 0 0 6px; }
  .faq-item p { font-family: Poppins, sans-serif; font-size: 14.5px; line-height: 1.7; color: #2C2C2A; margin: 0; max-width: 74ch; }

  .note { margin-top: 34px; font-size: 14px; color: var(--gray); font-style: italic; max-width: 68ch; }
  .note a { color: var(--navy); }
</style>
