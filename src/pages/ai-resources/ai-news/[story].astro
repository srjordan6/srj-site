---
// One page per top story: header + dateline + topic pills, key numbers,
// who's mentioned, chronological coverage, sources. "Why it matters"
// renders when the pipeline's analysis step supplies it (future field).
import BaseLayout from '../../../layouts/BaseLayout.astro';
export async function getStaticPaths() {
  const mods = import.meta.glob('../../../content/news/news.json', { eager: true });
  const news: any = Object.values(mods)[0]?.default ?? null;
  return (news?.stories ?? []).map((s: any) => ({ params: { story: s.Slug }, props: { s, date: news.date, generated: news.generated } }));
}
const { s, date, generated } = Astro.props;
const clean = (x: string) => x.replace(/\b\w/g, (c) => c.toUpperCase());

// The pipeline is written in Go, and Go marshals a nil slice to JSON null, not
// to []. So any story the clustering step finds no organizations, people,
// domains, or articles for arrives here with that field set to null rather
// than empty. Reading .slice/.map/.join/.length off null throws, and because
// these pages are prerendered, one such story fails the entire build and
// blocks every deploy, not just its own page.
//
// That is exactly what happened on July 28, 2026: the daily refresh published
// a Sam Altman story with Orgs: null, and the build died on s.Orgs.slice(0, 3).
// Guard every array field at the boundary. Fixing the pipeline to emit [] is
// the root-cause fix and is tracked separately, but the template must not be
// the single point of failure for a whole deploy either way.
const orgs: string[] = s.Orgs ?? [];
const persons: string[] = s.Persons ?? [];
const domains: string[] = s.Domains ?? [];
const articles: any[] = s.Articles ?? [];
---
<BaseLayout title={`${s.Headline} | AI News | SRJ Consulting & Services`} description={`Covered by ${s.DomainCount} outlets worldwide: coverage, key entities, and sources for this AI story, compiled by the SRJ pipeline.`}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><a href="/ai-resources/ai-news/">What&rsquo;s happening in the world of AI</a></p>
      <h1>{s.Headline}</h1>
      <p class="dateline">Daily briefing · {date} · compiled {new Date(generated).toUTCString().slice(0, 22)} UTC</p>
      <p class="pills">
        <span class="pill">#AI</span>
        {orgs.slice(0, 3).map((o: string) => (<span class="pill">#{clean(o).replace(/\s+/g, '')}</span>))}
      </p>
    </div>
  </section>
  <section class="body">
    <div class="container cols">
      <div class="main">
        {s.Why && (<><h2>Why it matters</h2><p class="why">{s.Why}</p></>)}
        <h2>Coverage</h2>
        <ul class="cov">
          {articles.map((a: any) => (
            <li>
              <a href={a.URL} rel="noopener nofollow" target="_blank">{a.Title}</a>
              <span class="meta">{a.Domain}{a.Date ? ` · ${a.Date}` : ''}</span>
            </li>
          ))}
        </ul>
        <p class="note">Coverage is discovery, never evidence. Where this story touches a law, framework, or requirement, the authoritative treatment lives in the <a href="https://srjconsultingservices.com/ai-governance/">AI Governance Reference Library</a>, verified against primary sources.</p>
      </div>
      <aside class="side">
        <div class="nums">
          <p class="box-label">Key numbers</p>
          <p class="num"><strong>{s.DomainCount}</strong> outlets</p>
          <p class="num"><strong>{s.ArticleCount}</strong> articles in 24h</p>
          <p class="doms">{domains.join(' · ')}</p>
        </div>
        {(persons.length > 0 || orgs.length > 0) && (
          <div class="who">
            <p class="box-label">Who&rsquo;s in this story</p>
            {persons.length > 0 && <p class="wl">People: {persons.map(clean).join(', ')}</p>}
            {orgs.length > 0 && <p class="wl">Organizations: {orgs.map(clean).join(', ')}</p>}
          </div>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { padding: 96px 0 40px; background: linear-gradient(180deg, var(--cream), var(--white)); }
  .eyebrow a { color: var(--orange); text-decoration: none; }
  h1 { max-width: 22ch; line-height: 1.2; }
  .dateline { color: var(--gray); font-size: 14px; }
  .pills { margin-top: 12px; }
  .pill { display: inline-block; background: var(--navy); color: #fff; font-family: Poppins, sans-serif; font-size: 12px; padding: 4px 12px; border-radius: 999px; margin: 0 6px 6px 0; }
  .body { padding: 8px 0 110px; }
  .cols { display: grid; grid-template-columns: minmax(0,1fr) 300px; gap: 48px; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; } }
  h2 { font-family: Lora, serif; color: var(--navy); font-size: 24px; margin: 34px 0 14px; }
  .why { font-size: 17px; line-height: 1.7; max-width: 62ch; }
  .cov { list-style: none; margin: 0; padding: 0; max-width: 760px; }
  .cov li { padding: 13px 0; border-bottom: 1px solid #e8e6e0; }
  .cov a { color: var(--navy); text-decoration: none; font-weight: 500; }
  .cov a:hover { color: var(--orange); }
  .cov .meta { display: block; font-size: 13px; color: var(--gray); margin-top: 3px; }
  .note { margin-top: 30px; font-size: 14px; color: var(--gray); font-style: italic; max-width: 66ch; }
  .note a { color: var(--navy); }
  .side { display: flex; flex-direction: column; gap: 24px; }
  .nums, .who { border: 1px solid #e6e4de; border-radius: 10px; padding: 20px 22px; background: #fafaf6; }
  .box-label { font-family: Poppins, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--orange); margin: 0 0 12px; }
  .num { font-size: 15px; margin: 0 0 6px; }
  .num strong { font-family: Lora, serif; font-size: 26px; color: var(--navy); margin-right: 6px; }
  .doms { font-size: 12.5px; color: var(--gray); line-height: 1.6; margin: 10px 0 0; }
  .wl { font-size: 14px; line-height: 1.6; margin: 0 0 8px; }
</style>
