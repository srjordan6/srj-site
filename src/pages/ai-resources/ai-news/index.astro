---
// Daily briefing: what's happening in the world of AI.
// Data: news/news.json v2 (clustered top stories), published daily by the
// pipeline. Tolerates absence and the v1 flat shape until the first v2 run.
//
// New content, so held to the full SEO and AEO standard rather than to parity:
// the old site has no equivalent page.
//
// The AEO decision here is ItemList plus real headings. The ten stories were
// previously rendered as spans inside anchors, which left the page with a single
// h1 and no h2 at all, the weakest heading structure on the site. A ranked list
// with no headings and no types reads, to an answer engine, as one undifferentiated
// block of link text. Each story is now an h2 inside an ItemList carrying its
// position, so a single story can be lifted and attributed and the ranking is
// legible as a ranking.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { itemList, faqPage, collectionPage } from '../../../lib/pageSchema';
const mods = import.meta.glob('../../../content/news/news.json', { eager: true });
const news: any = Object.values(mods)[0]?.default ?? null;
const stories = news?.stories ?? [];
const big = news?.big_picture ?? [];

// Go marshals a nil slice to JSON null, so a story with no domains, orgs, or
// people arrives with that field null rather than []. Reading .slice or
// .length off it throws and fails the whole prerender, blocking every deploy.
// Normalise once, here, rather than guarding at each use site.
const safeStories = stories.map((s: any) => ({
  ...s,
  Domains: s.Domains ?? [],
  Orgs: s.Orgs ?? [],
  Persons: s.Persons ?? [],
  Articles: s.Articles ?? [],
}));

const SITE = 'https://srjconsultingservices.com';
const url = `${SITE}/ai-resources/ai-news/`;
const count = safeStories.length;
const outlets = new Set(safeStories.flatMap((s: any) => s.Domains)).size;

const title = `AI News: Today's Top AI Stories, Ranked by Coverage | SRJ`;
const description =
  `A daily AI briefing: the top stories in artificial intelligence, ranked by breadth of ` +
  `global coverage, each with its sources. Compiled fresh every morning.`;

const faqs = [
  {
    q: `How are these AI stories chosen and ranked?`,
    a: `Stories are discovered from worldwide news coverage in the past 36 hours, clustered by ` +
       `headline similarity, and then ranked by how many distinct news outlets are covering them. ` +
       `Breadth of independent coverage is the ranking signal, not editorial preference and not ` +
       `raw article volume, which would let a single prolific outlet dominate.`,
  },
  {
    q: `How often is this briefing updated?`,
    a: `Once every morning, automatically. Each edition is dated and stamped with the time it was ` +
       `compiled, so it is always clear how current the page is.`,
  },
  {
    q: `Is news coverage treated as evidence?`,
    a: `No, and the distinction is deliberate. Coverage is a lead. A claim only enters the AI ` +
       `Governance Reference Library after it has been verified against a primary source such as ` +
       `the statute, the regulator's own publication, or the standard itself. Press is explicitly ` +
       `inadmissible as evidence in that library.`,
  },
  {
    q: `Why do some stories have many outlets but little analysis?`,
    a: `Because breadth of coverage measures how widely a story travelled, not how much it matters. ` +
       `A story carried by fifty outlets may still be routine. The ranking answers what the world ` +
       `is talking about, which is a different question from what carries consequence.`,
  },
];

const schema = [
  collectionPage({ url, name: 'AI News', description }),
  itemList({
    url,
    name: `Top AI stories, ${news?.date ?? 'daily briefing'}`,
    description,
    items: safeStories.map((s: any) => ({
      name: s.Headline,
      url: `${url}${s.Slug}/`,
      description: `Covered by ${s.DomainCount} outlets across ${s.ArticleCount} articles.`,
    })),
  }),
  faqPage(url, faqs),
];
---
<BaseLayout title={title} description={description} schema={schema} crumbName="AI News">
  <section class="hero">
    <div class="container">
      <h1>What&rsquo;s happening in the world of AI</h1>
      {news && <p class="dateline">Daily briefing · {news.date} · refreshed {new Date(news.generated).toUTCString().slice(0, 22)} UTC · {count} top stories · {outlets} outlets</p>}
    </div>
  </section>
  {big.length > 0 && (
    <section class="bigwrap">
      <div class="container">
        <div class="big">
          <p class="box-label">The big picture</p>
          <ul>{big.map((h: string) => (<li>{h}</li>))}</ul>
        </div>
      </div>
    </section>
  )}
  <section class="stories">
    <div class="container">
      {/* AEO: one self-contained paragraph answering the page's own question,
          readable with no surrounding context. This is the unit that gets lifted. */}
      <div class="answer">
        <p class="answer-label">In short</p>
        <p>
          This is a daily briefing of the biggest stories in artificial intelligence, ranked by
          how many independent news outlets are covering each one rather than by editorial
          preference. It is compiled automatically every morning from worldwide coverage. Treat
          it as discovery, not as evidence: a claim only enters the
          <a href="/ai-governance/">AI Governance Reference Library</a> once it has been verified
          against a primary source.
        </p>
      </div>

      {safeStories.length === 0 && <p class="empty">Today's briefing publishes with the pipeline's next morning run.</p>}
      {safeStories.map((s: any, i: number) => (
        <a class="story" href={`/ai-resources/ai-news/${s.Slug}/`}>
          <span class="rank">{i + 1}</span>
          <span class="stext">
            <h2 class="head">{s.Headline}</h2>
            <span class="meta"><strong>{s.DomainCount}</strong> outlets · {s.ArticleCount} articles · {s.Domains.slice(0, 4).join(', ')}{s.Domains.length > 4 ? '…' : ''}</span>
          </span>
        </a>
      ))}
      <p class="note">Stories rank by breadth of coverage across global outlets, discovered by the SRJ pipeline from worldwide news in the past 24 hours. Coverage is a lead, never fact evidence: claims enter the reference library only after verification against primary sources.</p>

      <section class="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Frequently asked questions</h2>
        <div class="rule"></div>
        {faqs.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </section>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { padding: 64px 0 40px; background: linear-gradient(180deg, var(--cream), var(--white)); }
  .dateline { color: var(--gray); font-size: 14px; letter-spacing: .04em; }
  .answer { max-width: 780px; margin: 6px 0 30px; background: #FFF6EC; border: 1px solid #F0D6B0; border-radius: 6px; padding: 22px 26px; }
  .answer p { font-family: Poppins, sans-serif; font-size: 16px; line-height: 1.7; color: #2C2C2A; margin: 0; }
  .answer a { color: #201868; }
  .answer-label { font-size: 11px !important; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #F07800; margin: 0 0 8px !important; }
  .bigwrap { padding: 8px 0 6px; }
  .big { border: 1px solid #e6e4de; border-left: 4px solid var(--orange); border-radius: 10px; background: #fafaf6; padding: 22px 26px; max-width: 860px; }
  .box-label { font-family: Poppins, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--orange); margin: 0 0 10px; }
  .big ul { margin: 0; padding-left: 20px; }
  .big li { margin: 0 0 8px; line-height: 1.55; font-size: 15.5px; color: #2c2c44; }
  .stories { padding: 26px 0 110px; }
  .story { display: flex; gap: 18px; align-items: flex-start; max-width: 860px; padding: 18px 6px; border-bottom: 1px solid #e8e6e0; text-decoration: none; }
  .story:hover .head { color: var(--orange); }
  .rank { font-family: Lora, serif; font-size: 26px; color: var(--orange); font-weight: 700; min-width: 34px; line-height: 1.1; }
  .head { display: block; font-family: Lora, serif; font-size: 20px; font-weight: 600; color: var(--navy); line-height: 1.35; margin: 0 0 5px; }
  .meta { display: block; font-size: 13.5px; color: var(--gray); }
  .meta strong { color: var(--navy); }
  .empty, .note { color: var(--gray); font-style: italic; font-size: 14px; max-width: 70ch; }
  .note { margin-top: 34px; }

  .faq { margin: 54px 0 0; }
  .faq h2 { font-family: Lora, serif; font-size: 26px; color: #201868; margin: 0 0 4px; font-weight: 600; }
  .rule { width: 56px; height: 3px; background: #F07800; margin: 0 0 20px; }
  .faq-item { padding: 18px 0; border-bottom: 1px solid #EDEBE5; }
  .faq-item:last-child { border-bottom: none; }
  .faq-item h3 { font-family: Lora, serif; font-size: 20px; font-weight: 700; color: #201868; margin: 0 0 7px; }
  .faq-item p { font-family: Poppins, sans-serif; font-size: 15px; line-height: 1.7; color: #2C2C2A; margin: 0; max-width: 74ch; }
</style>
