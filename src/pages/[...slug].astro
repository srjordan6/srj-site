---
/**
 * Stage 2: the 68 migrated pages, at their production URLs.
 *
 * WHAT THIS IS. Everything outside the AI Governance library and the four
 * /ai-resources/ sections: About, Contact, FAQ, the legal pages, the nine-page
 * Books hierarchy, the twelve-page Services hierarchy, eleven Industries pages,
 * eight blog category archives, five Insights posts, and the singletons. One
 * route renders all of them from one extracted dataset.
 *
 * PARITY IS THE RULE, same as Stage 1. These pages are migrated, not rewritten.
 * Title, meta description, canonical, Open Graph tags and the full JSON-LD graph
 * are lifted verbatim from production, so SEO and schema parity are exact rather
 * than reconstructed. The body is production's own markup with theme chrome
 * removed by selector, which means wp-block-* classes, inline style attributes
 * and Kadence wrappers all carry across untouched. Tidying them would be a
 * redesign nobody reviewed; if that is wanted it is a separate pass with its own
 * before-and-after.
 *
 * WHY A CATCH-ALL AND NOT 68 FILES. The content is data, not code. 68 near
 * identical .astro files would be 68 places for the same bug, and the moment
 * production changes a title the files and the site disagree with no way to
 * tell. Rendering from one dataset means re-running the extractor is the whole
 * update.
 *
 * ROUTE PRECEDENCE. This is a rest parameter at the site root, so in principle
 * it matches everything. It does not in practice: getStaticPaths emits exactly
 * the 68 paths in the dataset, and Astro prefers more specific routes, so
 * /ai-governance/*, /ai-resources/*, and the home page all keep their own
 * handlers. The dataset is asserted against that list below rather than trusted.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BookSpecs from '../components/BookSpecs.astro';
import migrated from '../content/migrated/migrated-pages.json';
import mainClasses from '../content/migrated/main-classes.json';
import { rewriteAssets, rewriteAssetUrl, rewriteInternalLinks, decorateConsentFrames, ASSET_BASE } from '../lib/assets';
import type { Crumb } from '../lib/pageSchema';

export async function getStaticPaths() {
  const doc: any = migrated;
  const pages: any[] = doc.pages ?? [];

  // Paths owned by a more specific route. If the extractor ever picks one of
  // these up, two handlers would claim the same URL and which one wins is a
  // build-order detail, not a decision. Fail instead.
  const RESERVED = ['/ai-governance/', '/ai-resources/', '/resources/ai-glossary/'];

  // Paths that are now redirect rules in public/_redirects. Building a page
  // here as well would put a static file and a redirect rule on the same URL,
  // and which one answers is not something to leave to build order.
  const REDIRECTED = ['/resources/'];

  return pages
    .filter((p) => !REDIRECTED.includes(p.path))
    .map((p) => {
      const path: string = p.path;
      if (RESERVED.some((r) => path.startsWith(r))) {
        throw new Error(
          `Migrated dataset contains ${path}, which is owned by a dedicated route. ` +
          `Two handlers would claim the same URL. Remove it from the extractor.`
        );
      }
      // '/services/business-services/' -> 'services/business-services'
      const slug = path.replace(/^\/|\/$/g, '');
      return { params: { slug: slug || undefined }, props: { page: p } };
    });
}

const { page } = Astro.props as any;

// Production's own values, not regenerated. An empty description is meaningful:
// five category archives genuinely ship without one, and inventing them would
// break the parity the migration is measured on.
const title = page.title || '';
const description = page.description || '';
const canonical = page.canonical || '';

// The JSON-LD comes across as raw strings so the graph is byte-identical to
// production. Parsing and re-serialising would reorder keys and change the
// bytes for no benefit. Asset references inside it are repointed, because the
// graph carries image URLs that would 404 after cutover like any other.
const schemaRaw: string[] = (page.schema ?? []).map((s: string) => rewriteAssets(s));

// wp-content references are repointed at the asset bucket, and absolute
// internal links are made root-relative so navigation stays on this site on
// staging and production alike. See src/lib/assets.ts: the extracted markup
// keeps production's own bytes, and both rewrites only enter at render, so
// the content file stays diffable against production.
const body = decorateConsentFrames(rewriteInternalLinks(rewriteAssets(page.main)));

// Stylesheets WordPress enqueued only on this template. The extractor records
// the filename; the directory differs by source, so plugin stylesheets are
// resolved under plugins/ and the theme's own under the child theme.
const PLUGIN_CSS: Record<string, string> = {
  'fluent-forms-public.css': 'plugins/fluentform/assets/css/fluent-forms-public.css',
  'fluentform-public-default.css': 'plugins/fluentform/assets/css/fluentform-public-default.css',
};
const pageCss: string[] = [
  // The scoped WP theme baseline. Migrated markup was authored against the
  // child theme's global style.css and Kadence's base (16px body, 32/28/24px
  // heading scale); without it the pages render on BaseLayout's 17px base and
  // clamp() headings sized for the governance library — visibly oversized
  // text, reported by Stephen July 30. Every selector inside is scoped under
  // .migrated so nothing leaks into site chrome. Loaded first so page-specific
  // stylesheets keep cascade priority, same order WordPress enqueued them.
  '/migrated-theme.css',
  // page_css is an array on 71 of 72 migrated pages; /autonomous-soc/ arrived
  // from the migration with "" and took the whole build down on 2026-08-17
  // ("(page.page_css ?? []).map is not a function" - "" survives ?? because
  // it is not null). Coerce every shape: array passes through, a non-empty
  // string becomes one entry, everything else contributes nothing.
  ...(Array.isArray(page.page_css) ? page.page_css : page.page_css ? [page.page_css] : []).map((f: string) =>
    `${ASSET_BASE}/wp-content/${PLUGIN_CSS[f] ?? `themes/srj-consulting/assets/css/${f}`}`
  ),
];

// Visible breadcrumb trail, from production's own BreadcrumbList.
//
// The derived trail labels the current page with page.h1, which on the hub
// pages is the full hero sentence — /services/ showed "Home › Two pillars.
// Nine service lines. One operating model." instead of "Home › Services".
// Every migrated page already carries production's BreadcrumbList in its
// schema, with the real name for every level, so the visible nav reads the
// same graph and the two can never disagree. Item URLs are made root-relative
// for the same reason every other internal link is. Pages whose graph has no
// BreadcrumbList fall back to the derived trail.
let prodCrumbs: Crumb[] | undefined;
for (const s of page.schema ?? []) {
  if (!s.includes('"BreadcrumbList"')) continue;
  try {
    const g = JSON.parse(s);
    const bc = g['@type'] === 'BreadcrumbList'
      ? g
      : (g['@graph'] ?? []).find((n: any) => n['@type'] === 'BreadcrumbList');
    const items = bc?.itemListElement;
    if (Array.isArray(items) && items.length > 1) {
      const sorted = [...items].sort((a: any, b: any) => (a.position ?? 0) - (b.position ?? 0));
      // Names in authored BreadcrumbList JSON-LD sometimes carry HTML
      // entities (&amp;). Astro escapes interpolated text again, which
      // rendered a literal "&amp;" in the trail. Decode the common ones
      // here so the visible crumb shows the character, not the entity.
      const deent = (t: string) => t
        .replace(/&amp;/g, '&').replace(/&#0?38;/g, '&')
        .replace(/&#8217;|&rsquo;/g, '\u2019').replace(/&#8211;|&ndash;/g, '\u2013');
      prodCrumbs = sorted.map((it: any, i: number) => ({
        name: deent(String(it.name ?? '')),
        url: i < sorted.length - 1 && it.item
          ? (String(it.item).replace('https://srjconsultingservices.com', '') || '/')
          : undefined,
      }));
      break;
    }
  } catch {
    // Raw string was not parseable JSON; the derived trail is the fallback.
  }
}
// Classes production's <main> element carried, per path. The extractor strips
// the <main> wrapper as theme chrome, and its classes went with it — which
// left every stylesheet scoped under them inert. The map is harvested live
// from production (srj-content migrated/main-classes.json); paths absent from
// it are templates that emit no <main> at all.
//
// STRUCTURE MATTERS, NOT JUST THE CLASSES. These classes go on an INNER div
// nested inside the .migrated scope, never merged onto the scope element
// itself. The harvested selectors read `:where(.migrated) .book-detail
// .book-hero`, which requires .book-detail to be a DESCENDANT of the scope;
// with both classes on one element the chain can never match and every rule
// keyed to the main classes goes silently inert — which is precisely how the
// book pages rendered bare while their styles sat correct in the stylesheet
// (Stephen, July 30). Nesting reproduces production's own containment:
// body > main.books-page.book-detail > section.book-hero.
const mainClass = (mainClasses as any).classes[page.path] ?? '';
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={page.og_title}
  ogDescription={page.og_description}
  ogImage={rewriteAssetUrl(page.og_image)}
  robots={page.robots}
  rawSchema={schemaRaw}
  pageCss={pageCss}
  crumbs={prodCrumbs}
  crumbName={page.h1 || title}
>
  <div class="migrated">
    <div class={mainClass || undefined} set:html={body} />
  </div>
  {/* Bibliographic specs and Book/Offer schema for the nine book detail pages.
      Renders nothing on any other path, and nothing for a forthcoming title,
      which has no ISBN, price, or availability to assert.

      Every fact comes from srj-content/books/books.json, generated from
      press_books and press_book_isbns, so a status or a price cannot drift from
      the database. That is the failure being designed out: the press kit had
      Book 04 marked "Forthcoming" for five days after it published, because the
      same fact was hardcoded in three places.

      The prose above is untouched. The block adds 52 words, which is 1.43 to
      1.70 percent of each book body, inside gate 15's two percent content-parity
      tolerance. Checked, not assumed: on a shorter page 52 words would breach
      it. */}
  <BookSpecs path={page.path} />
{/* Keep the header's top portion pinned on the contact page, Stephen's
    July 31 directive, so the booking flow never loses the chrome. */}
{page.path === '/contact/' && <style is:global set:html={'header.site-header{position:sticky;top:0;z-index:999}'}></style>}
</BaseLayout>

<style is:global>
  /* The migrated body arrives with production's own classes and inline styles.
     Nothing is restyled here: this only gives the transplanted markup a sane
     baseline where the theme stylesheet expected a wrapper it no longer has. */
  .migrated { width: 100%; }
  .migrated img { max-width: 100%; height: auto; }
  .migrated table { max-width: 100%; }
</style>
