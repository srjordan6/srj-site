---
// Base shell for every page. SEO surface is emitted here, exactly:
// title, meta description, canonical, OG, and the Organization graph.
// Per-page schema (Article/FAQ/HowTo/VideoObject) is passed via the
// `schema` prop as ready JSON-LD objects and rendered verbatim.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object[];
  ogImage?: string;
}
const { title, description, canonical, schema = [], ogImage } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// Entity graph, reproduced from the production Rank Math output node for node.
// The migration schema-parity gate requires the emitted @type set per URL to be
// a superset of production's, and the July 28 parity crawl showed 64 of 64
// governance pages missing Place, PostalAddress, GeoCoordinates, ImageObject,
// and WebSite because the shell emitted Organization alone. @id values are the
// production ones so downstream references keep resolving after cutover.
const SITE = 'https://srjconsultingservices.com';
const ORG_NAME = 'SRJ Consulting & Services LLC';

const orgGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: ORG_NAME,
      url: `${SITE}/`,
      logo: { '@id': `${SITE}/#logo` },
      image: { '@id': `${SITE}/#logo` },
      location: { '@id': `${SITE}/#place` },
      founder: { '@type': 'Person', name: 'Stephen R. Jordan', url: `${SITE}/about/` },
    },
    {
      '@type': 'Place',
      '@id': `${SITE}/#place`,
      geo: { '@type': 'GeoCoordinates', latitude: '33.189778366864', longitude: '-96.764620919976' },
      address: {
        '@type': 'PostalAddress',
        streetAddress: '13054 Cinderella Lane',
        addressLocality: 'Frisco',
        addressRegion: 'TX',
        postalCode: '75035',
        addressCountry: 'US',
      },
    },
    {
      '@type': 'ImageObject',
      '@id': `${SITE}/#logo`,
      url: `${SITE}/wp-content/uploads/SRJ-Consulting-Services-Medium.jpg`,
      contentUrl: `${SITE}/wp-content/uploads/SRJ-Consulting-Services-Medium.jpg`,
      caption: ORG_NAME,
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: ORG_NAME,
      publisher: { '@id': `${SITE}/#organization` },
      inLanguage: 'en-US',
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(orgGraph)} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <Header />
  <main><slot /></main>
  <Footer />
</body>
</html>
