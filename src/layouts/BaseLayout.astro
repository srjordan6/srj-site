---
// Base shell for every page. SEO surface is emitted here, exactly:
// title, meta description, canonical, OG, breadcrumbs, and the entity graph.
// Per-page schema (Article/FAQ/HowTo/DefinedTermSet/ItemList) is passed via the
// `schema` prop as ready JSON-LD objects and rendered verbatim.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
// Shared with the governance render path, which never passes through this
// layout. See src/lib/entityGraph.ts.
import { entityNodes, webPageNode } from '../lib/entityGraph';
import { breadcrumbList, crumbsFromPath, type Crumb } from '../lib/pageSchema';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object[];
  ogImage?: string;
  /** Override the derived trail. Omit to derive from the URL. */
  crumbs?: Crumb[];
  /** Label for the current page in the derived trail. Defaults to the segment. */
  crumbName?: string;
  /** Set false only on the homepage, where a one-item trail is noise. */
  showBreadcrumbs?: boolean;
  /**
   * Migrated pages only. Production's JSON-LD, carried across as raw strings so
   * the graph is byte-identical rather than reparsed and reserialised.
   *
   * Supplying this SUPPRESSES the generated entity graph and BreadcrumbList
   * below, because production's graph already contains Organization, WebSite,
   * WebPage and BreadcrumbList nodes. Emitting both would put two Organization
   * nodes on the page, which is exactly the stale-NAP duplication the theme's
   * own structured-data function was retired for. The visible breadcrumb trail
   * still renders; only the duplicate markup is withheld.
   */
  rawSchema?: string[];
  /** Migrated pages only. Production's own OG values, when they differ from title/description. */
  ogTitle?: string;
  ogDescription?: string;
  /** Migrated pages only. Carried across so noindex rules survive the migration. */
  robots?: string;
  /**
   * Migrated pages only. Absolute URLs of stylesheets this page needs beyond
   * the shared one.
   *
   * WordPress enqueued these conditionally, one per template: about-page.css on
   * About, contact-page.css on Contact, blog-post.css on the ten Insights
   * posts, Fluent Forms CSS on the five book pages that carry a signup form.
   * They only appear in the <head> of the page that uses them, so an asset
   * inventory built by scanning rendered pages finds style.css and misses every
   * one of these. 19 of the 70 migrated pages need at least one, and without
   * them those pages render with the shared stylesheet only and lose their
   * page-specific layout.
   */
  pageCss?: string[];
}
const {
  title, description, canonical, schema = [], ogImage,
  crumbs, crumbName, showBreadcrumbs = true,
  rawSchema = [], ogTitle, ogDescription, robots, pageCss = [],
} = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const hasRaw = rawSchema.length > 0;

// Every governance page emits BreadcrumbList and none of the .astro pages did.
// Deriving the trail here rather than in each template means no page can ship
// without one, and the visible nav and the schema can never disagree, since
// both read the same array.
const trail = crumbs ?? crumbsFromPath(Astro.url.pathname, crumbName ?? title);
const hasTrail = showBreadcrumbs && trail.length > 1;

// Entity graph, shared with the governance render path via src/lib/entityGraph.ts.
// Keeping it in one module is deliberate: the July 28 parity crawl found all 67
// governance URLs missing Place, PostalAddress, GeoCoordinates, ImageObject,
// and WebSite precisely because those pages never render through this layout.
const orgGraph = {
  '@context': 'https://schema.org',
  '@graph': [...entityNodes(), webPageNode(canonicalUrl, title, description)],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {robots && <meta name="robots" content={robots} />}
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:url" content={canonicalUrl} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  {pageCss.map((href) => <link rel="stylesheet" href={href} />)}
  {hasRaw
    ? rawSchema.map((s) => <script type="application/ld+json" set:html={s} />)
    : (<>
        <script type="application/ld+json" set:html={JSON.stringify(orgGraph)} />
        {hasTrail && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbList(trail))} />}
      </>)}
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <Header />
  {hasTrail && (
    <nav class="srj-breadcrumbs" aria-label="Breadcrumb">
      <div class="container">
        <ol>
          {trail.map((c) => (
            <li>{c.url ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))}
        </ol>
      </div>
    </nav>
  )}
  <main><slot /></main>
  <Footer />
</body>
</html>

<style is:global>
  .srj-breadcrumbs { border-bottom: 1px solid #EDEBE5; background: #fff; }
  .srj-breadcrumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 11px 0; font-family: Poppins, sans-serif; font-size: 13px; }
  .srj-breadcrumbs li + li::before { content: "\203A"; color: #7A8A9E; margin-right: 8px; }
  .srj-breadcrumbs a { color: #201868; text-decoration: none; }
  .srj-breadcrumbs a:hover { color: #F07800; }
  .srj-breadcrumbs [aria-current] { color: #7A8A9E; }
</style>
