---
const year = new Date().getFullYear();

// Footer links point at canonical destinations, not the paths that redirect to
// them. /resources/ai-glossary/ 301s to /ai-resources/ai-glossary/, so linking
// the old one made every page in the site spend a hop to reach its own glossary
// and passed a redirect where a direct link belonged.
---
<footer class="site-footer">
  <div class="container cols">
    <div>
      <p class="f-brand">SRJ Consulting &amp; Services LLC</p>
      <p class="f-line">Operator-led AI advisory. Frisco, Texas.</p>
      <p class="f-line">The Operating Discipline for AI Library&trade;</p>
    </div>
    <nav aria-label="Footer">
      <a href="/ai-governance/">AI Governance Library</a>
      <a href="/ai-resources/ai-glossary/">AI Glossary</a>
      <a href="/books/">Books</a>
      <a href="/schedule-consultation/">Schedule a Consultation</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/disclaimer/">Disclaimer</a>
    </nav>
  </div>
  <div class="container legal">
    <p>&copy; {year} SRJ Consulting &amp; Services LLC. All rights reserved.</p>
  </div>
</footer>
<style>
  .site-footer { background: var(--navy-deep); color: var(--cream); margin-top: 90px; padding: 56px 0 28px; }
  .cols { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; }
  .f-brand { font-family: var(--font-head); font-size: 20px; color: var(--white); margin-bottom: 6px; }
  .f-line { font-size: 14px; opacity: .8; margin: 0 0 4px; }
  nav { display: grid; gap: 8px; align-content: start; }
  nav a { color: var(--cream); font-size: 14px; text-decoration: none; }
  nav a:hover { color: var(--orange); }
  .legal { border-top: 1px solid rgba(255,255,255,.12); margin-top: 40px; padding-top: 20px; }
  .legal p { font-size: 12.5px; opacity: .6; margin: 0; }
  @media (max-width: 700px) { .cols { grid-template-columns: 1fr; } }
</style>
