---
/**
 * Tracker declarations, consent-gated.
 *
 * HOW THIS WORKS. Every tracker ships as <script type="text/plain">, a type no
 * browser executes. The consent bootstrap rewrites it to a real script only
 * when the matching category has been granted. "Not consented" therefore means
 * NEVER RAN, not "ran and was ignored" — which is the distinction that matters
 * if anyone ever asks.
 *
 * SESSION REPLAY IS NOT ORDINARY ANALYTICS. Microsoft Clarity records pointer
 * movement, clicks, scrolling, and keystrokes into form fields, and replays
 * them. GA4 and StatCounter count page views. Grouping all three under one
 * "statistics" label and describing it as "how the site is used" would be
 * technically true and practically misleading, and consent obtained by a
 * misleading description is not consent. The banner copy names session
 * recording explicitly for this reason.
 *
 * CLARITY IS EXCLUDED FROM THE FORM PAGES, deliberately. See `excludeClarity`
 * below. Clarity's own masking is a setting in someone else's dashboard that
 * can be changed without anyone here noticing; not loading it at all on those
 * pages is a property of this site that cannot be silently undone.
 */

export interface Props {
  /** Current path, used to decide whether Clarity is allowed to load here. */
  path?: string;
}

const { path = '' } = Astro.props;

const GA4_ID = 'G-WWP3BSKN5N';
const CLARITY_ID = 'wxtqd3ud7i';
const STATCOUNTER_PROJECT = '13170872';
const STATCOUNTER_SECURITY = 'd3cb9c8b';

/**
 * Pages where session recording must not run.
 *
 * /contact/ carries name, email, phone and a free-text message. /client-upload/
 * carries an organisation name, an engagement reference, and a description of
 * confidential client material. Recording keystrokes on either means Microsoft
 * receives client-confidential information, and on the upload page it may mean
 * receiving a description of material covered by an engagement's own
 * confidentiality terms.
 *
 * No consent checkbox makes that acceptable, because the visitor consenting is
 * not the party whose confidentiality is at stake.
 */
const CLARITY_EXCLUDED = ['/contact/', '/client-upload/'];
const clarityAllowed = !CLARITY_EXCLUDED.some((p) => path.startsWith(p));

/**
 * GA4 custom dimensions, resolved at build time from the path.
 *
 * `pillar` is the top-level section a page belongs to (books, services,
 * ai-governance, ai-resources ...), `section` the level below it. Page paths
 * alone say nothing about how the site is organised, so questions like which
 * area of the site produces consultation enquiries are unanswerable without
 * these. Registered as event-scoped custom dimensions in the GA4 property.
 */
const _seg = path.split('/').filter(Boolean);
const gaPillar = _seg[0] || 'home';
const gaSection = _seg[1] ? _seg.slice(0, 2).join('/') : (_seg[0] || 'home');

/**
 * CLARITY CUSTOM TAGS. Deliberately the SAME pillar and section values GA4
 * gets above, computed from the same two constants rather than re-derived.
 *
 * The reason is that these two tools get compared. GA4 says where enquiries
 * come from; Clarity shows the sessions behind the number. If `section` meant
 * `books` in one tool and `books/ai-risk-governance-security` in the other,
 * every such comparison would be quietly wrong, and wrong in a way that looks
 * fine until someone acts on it. One vocabulary, two tools.
 *
 * `volume` is the one tag with no GA4 counterpart. A Library volume is not
 * inferable from the path segments alone, and without it every book detail
 * page collapses into one undifferentiated `books` bucket, so "which volume do
 * people read without clicking through to buy" cannot be asked at all.
 *
 * All three are derived from the path at build time. No visitor attribute is
 * involved and nothing narrows toward a person: Clarity tags stay queryable
 * indefinitely, and a tag added as a convenience becomes a profile.
 */
const VOLUME_BY_SLUG: Record<string, string> = {
  'the-ai-business-enablement-audit': 'i',
  'the-ai-readiness-performance-assessment': 'ii',
  'the-ai-risk-governance-review': 'iii',
  'the-ai-efficiency-process-optimization': 'iv',
  'the-ai-it-security-audit': 'v',
  // VI-IX are in development. Listed before they publish because a slug costs
  // nothing until the page exists, and adding it after launch leaves the first
  // weeks of that volume's traffic untagged with no way to backfill. Slugs
  // match press_books.url_path, which is the system of record.
  'the-ai-it-security-implementation-strategy': 'vi',
  'the-secure-by-design': 'vii',
  'the-application-security': 'viii',
  'the-cloud-infrastructure-security': 'ix',
};

const clarityTags: Record<string, string> = clarityAllowed
  ? { pillar: gaPillar, section: gaSection }
  : {};
if (clarityAllowed && VOLUME_BY_SLUG[_seg[_seg.length - 1]]) {
  clarityTags.volume = VOLUME_BY_SLUG[_seg[_seg.length - 1]];
}
const clarityTagCalls = Object.entries(clarityTags)
  .map(([k, v]) => `w.clarity("set", ${JSON.stringify(k)}, ${JSON.stringify(v)});`)
  .join('\n      ');
---

{/* GA4. gtag() and the Consent Mode defaults are already established by the
    bootstrap in src/lib/consent.ts, which runs earlier in <head>, so this tag
    inherits denied-by-default rather than racing it. */}
<script
  type="text/plain"
  data-consent="statistics"
  data-src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}
  async
></script>
<script type="text/plain" data-consent="statistics" set:html={`
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  gtag('js', new Date());
  gtag('config', '${GA4_ID}', {
    anonymize_ip: true,
    /* Cross-domain measurement across all four SRJ properties. The list must
       be identical on every property or the linking is one-way: a domain
       that does not name its partners will not honour the incoming link
       parameter, and the visitor starts a new unattributed session there.
       outcomestar.app and aiauditforcompanies.com still need this same list
       added in their own codebases. */
    linker: { domains: ['srjconsultingservices.com', 'theworldofai.org', 'aiauditforcompanies.com', 'outcomestar.app'], decorate_forms: true },
    pillar: ${JSON.stringify(gaPillar)},
    section: ${JSON.stringify(gaSection)}
  });

  /* Business-relevant clicks as their own events, so they can be marked key
     events in GA4 without further code. Both carry the dimensions above, so
     we can see which part of the site produces enquiries rather than only
     which produces traffic. */
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest && e.target.closest('a');
    if (!a || !a.href) return;
    var d = { pillar: ${JSON.stringify(gaPillar)}, section: ${JSON.stringify(gaSection)}, link_url: a.href };
    if (a.href.indexOf('/schedule-consultation') > -1 || a.href.indexOf('/contact') > -1) {
      gtag('event', 'consultation_intent', d);
    } else if (a.href.indexOf('amazon.') > -1) {
      gtag('event', 'affiliate_click', d);
    } else if (a.href.indexOf('theworldofai.org') > -1) {
      gtag('event', 'twoai_referral', d);
    }
  }, true);
`}></script>

{/* Microsoft Clarity. Session recording, so not on the form pages. */}
{clarityAllowed && (
  <script type="text/plain" data-consent="statistics" set:html={`
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "${CLARITY_ID}");
  `}></script>
)}

{/* Clarity custom tags, consent-gated and declared AFTER the loader above.

    TWO THINGS HAVE TO HOLD for a tag to land, and both do. The consent
    bootstrap activates pending scripts with querySelectorAll and replaces them
    in document order, so this runs after the loader. And Clarity's snippet
    installs a queueing stub (c[a].q) synchronously, so a set() call made before
    the remote script finishes downloading is queued rather than dropped.

    Guarded on window.clarity existing anyway. If a path is added to
    CLARITY_EXCLUDED without updating this block, or the loader is removed, the
    guard degrades it to a no-op instead of a ReferenceError on every page. */}
{clarityAllowed && clarityTagCalls && (
  <script type="text/plain" data-consent="statistics" set:html={`
    (function (w) {
      if (!w.clarity) return;
      ${clarityTagCalls}
    })(window);
  `}></script>
)}

{/* StatCounter. Page counts only. The <noscript> pixel that shipped with the
    WordPress version is deliberately NOT carried: a no-JS fallback fires
    without consent by definition, since consent is enforced in JS. A visitor
    with JavaScript disabled is simply not counted, which is the correct
    trade. */}
<script type="text/plain" data-consent="statistics" set:html={`
  var sc_project=${STATCOUNTER_PROJECT};
  var sc_invisible=1;
  var sc_security="${STATCOUNTER_SECURITY}";
`}></script>
<script
  type="text/plain"
  data-consent="statistics"
  data-src="https://www.statcounter.com/counter/counter.js"
  async
></script>
