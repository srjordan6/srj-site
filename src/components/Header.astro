---
// Primary navigation.
//
// Rebuilt 2026-07-30 to match the production WordPress header, from Stephen's
// screenshot of the live site rather than memory: a two-tier header. The navy
// topbar carries location, phone, email on the left and Search plus the
// consultation CTA on the right; the light main bar carries the serif
// wordmark with the library tagline and the nav links.
//
// Nav items are production's minus FAQ, removed on Stephen's instruction
// 2026-07-30 (the page still exists and stays linked from the footer).
//
// ONE DELIBERATE DEPARTURE FROM PRODUCTION. Resources points at /ai-resources/,
// not the /resources/ that WordPress links to. /resources/ is the legacy page,
// titled "Reference Material", whose only outbound link is the glossary.
// /ai-resources/ is the rebuilt hub that actually indexes the glossary, tools,
// people, news and everything-else sections. Matching production literally here
// would point the primary nav at the page the rebuild replaced.
//
// Home is reached through the brand mark, which is how production does it too.
// If this list changes, check it against the live site rather than editing from
// memory, because the failure is silent: the nav still renders, it is just wrong.
//
// SEARCH. The topbar Search button opens a panel backed by Pagefind, whose
// index is generated at build time (`pagefind --site dist`). The UI script and
// CSS load lazily on first open, so pages that never see a search pay nothing.
const nav = [
  { href: '/about/',        label: 'About' },
  { href: '/services/',     label: 'Services' },
  { href: '/applications/', label: 'Applications' },
  { href: '/industries/',   label: 'Industries' },
  { href: '/books/',        label: 'Books' },
  { href: '/ai-resources/', label: 'AI Resources' },
  { href: '/contact/',      label: 'Contact' },
];
const current = Astro.url.pathname;

const PHONE_DISPLAY = '(415) 413-7772';
const PHONE_TEL = '+14154137772';
const EMAIL = 'info@srjconsultingservices.com';
---
<header class="site-header">

  {/* Tier 1: navy topbar */}
  <div class="topbar">
    <div class="container topbar-inner">
      <div class="topbar-contact">
        {/* Language selection owns the topbar left, Stephen's July 31
            directive: a type-ahead input (datalist) driving a hidden Google
            Translate combo, replacing the unreadable stock widget. Phone and
            email removed from the topbar on the same instruction; they remain
            in the footer Contact column. */}
        <span class="topbar-translate"><input id="srj-lang-input" list="srj-langs" placeholder="Language" autocomplete="off" aria-label="Translate this page" /><datalist id="srj-langs"></datalist><span id="google_translate_element" class="gt-hidden"></span></span>
      </div>
      <div class="topbar-actions">
        <button type="button" class="search-toggle" aria-expanded="false" aria-controls="srj-search-panel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" width="15" height="15">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.3" y2="16.3"></line>
          </svg>
          <span>Search</span>
        </button>
        <a class="topbar-cta" href="/schedule-consultation/">
          Schedule a Free AI Consultation <span class="arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  {/* Search panel sits between the tiers so it reads as part of the topbar */}
  <div id="srj-search-panel" class="search-panel" hidden>
    <div class="container">
      <div id="srj-search-box"></div>
      <p class="search-hint">Searches every page: governance library, books, services, glossary, tools, insights.</p>
    </div>
  </div>

  {/* Tier 2: main bar */}
  <div class="mainbar">
    <div class="container bar">
      <a class="brand" href="/">
        <span class="brand-line">SRJ Consulting <span class="amp">&amp;</span>Services</span>
        <span class="brand-tag">The Operating Discipline for AI Library&trade;</span>
      </a>
      <nav aria-label="Primary">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<script is:inline>
// Lazy Pagefind. The index and UI assets live under /pagefind/ in the build
// output; nothing is fetched until the first open. Escape closes, and focus
// lands in the input on open.
(function () {
  var toggle = document.querySelector('.search-toggle');
  var panel = document.getElementById('srj-search-panel');
  if (!toggle || !panel) return;
  var loaded = false;

  function loadPagefind() {
    if (loaded) return Promise.resolve();
    loaded = true;
    return new Promise(function (resolve) {
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(css);
      var s = document.createElement('script');
      s.src = '/pagefind/pagefind-ui.js';
      s.onload = function () {
        /* global PagefindUI */
        new PagefindUI({
          element: '#srj-search-box',
          showSubResults: true,
          showImages: false,
          translations: { placeholder: 'Search srjconsultingservices.com' },
        });
        resolve();
      };
      s.onerror = function () {
        panel.querySelector('#srj-search-box').textContent =
          'Search could not load. Please try again, or browse from the navigation above.';
        resolve();
      };
      document.head.appendChild(s);
    });
  }

  function openPanel() {
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    loadPagefind().then(function () {
      var input = panel.querySelector('input');
      if (input) input.focus();
    });
  }
  function closePanel() {
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
  }

  toggle.addEventListener('click', function () {
    panel.hidden ? openPanel() : closePanel();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !panel.hidden) { closePanel(); toggle.focus(); }
  });
})();
</script>

<style>
  /* Values below are PRODUCTION'S OWN, lifted verbatim from the child theme
     stylesheet (srj-consulting style.css, mirrored in migrated-theme.css)
     after Stephen's July 30 screenshot showed this header drifting from the
     live site: wrong topbar shade (navy vs navy-deep), cream mainbar where
     production uses blurred paper-white, 27px/600 wordmark vs 25px/400,
     15.5px nav vs 14px, and a color-swap hover where production animates an
     orange underline. Literal hexes, not tokens, so a token edit cannot
     drift this chrome away from the WP original again. */
  /* display:contents dissolves the wrapper's box so the two tiers lay out as
     body-level children, which is what production has (announce and
     header.nav are siblings in <body>). Without this, .mainbar's sticky
     would be caged inside the wrapper's own height and stop sticking one
     header-height into the scroll. */
  .site-header { display: contents; }

  /* ---- tier 1: topbar (production .announce) ---- */
  .topbar { background: #1A1357; color: #fafaf6; padding: 11px 0; font-size: 13px; letter-spacing: .01em; }
  .topbar-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 30px; flex-wrap: wrap;
  }
  .topbar-contact { display: flex; align-items: center; gap: 24px; color: rgba(250,250,246,.78); font-family: 'Poppins', sans-serif; font-size: 12.5px; letter-spacing: .02em; }
  .topbar-loc { color: rgba(250,250,246,.55); }
  .topbar-dot { color: #F07800; font-size: 9px; }
  .topbar-contact a { color: rgba(250,250,246,.92); font-weight: 500; text-decoration: none; transition: color .2s ease; display: inline-flex; align-items: center; gap: 7px; }
  .topbar-contact a:hover { color: #F07800; }
  .topbar-actions { display: flex; align-items: center; gap: 22px; }
  .search-toggle {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 4px;
    color: #ffffff;
    font-family: 'Poppins', 'Open Sans', sans-serif;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    transition: background .15s ease, border-color .15s ease;
  }
  .search-toggle svg { display: block; width: 14px; height: 14px; }
  .search-toggle:hover, .search-toggle:focus-visible { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.45); outline: none; }
  .search-toggle[aria-expanded="true"] { background: #F07800; border-color: #F07800; color: #ffffff; }
  .topbar-cta {
    font-family: 'Poppins', sans-serif;
    font-size: 11.5px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #F07800;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: opacity .2s ease;
    white-space: nowrap;
  }
  .topbar-cta:hover { opacity: .75; }
  .topbar-cta .arrow { font-size: 14px; letter-spacing: 0; }

  /* ---- search panel ---- */
  .search-panel {
    background: #1A1357;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 22px 0 26px;
  }
  .search-hint { margin: 10px 0 0; font-size: 12.5px; color: rgba(255, 255, 255, 0.6); }
  /* Pagefind UI variables: brand it rather than shipping the default grey. */
  .search-panel :global(.pagefind-ui) {
    --pagefind-ui-primary: #F07800;
    --pagefind-ui-text: #ffffff;
    --pagefind-ui-background: #1A1357;
    --pagefind-ui-border: rgba(255, 255, 255, 0.25);
    --pagefind-ui-tag: #201868;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: 'Poppins', sans-serif;
  }
  .search-panel :global(.pagefind-ui__result-link) { color: #F07800; }
  .search-panel :global(.pagefind-ui__result-excerpt) { color: rgba(255, 255, 255, 0.8); }

  /* ---- tier 2: main bar (production header.nav) ---- */
  .mainbar {
    /* Production: the announce bar scrolls away; header.nav alone sticks. */
    position: sticky; top: 0; z-index: 100;
    background: rgba(250,250,246,.94);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid #e4e2dc;
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-top: 22px; padding-bottom: 22px; }
  .brand { display: flex; flex-direction: column; gap: 4px; line-height: 1; text-decoration: none; }
  .brand-line {
    font-family: 'Lora', serif;
    font-weight: 400;
    font-size: 25px;
    line-height: 1;
    color: #201868;
    letter-spacing: -0.01em;
  }
  .brand-line .amp { color: #F07800; font-style: italic; padding: 0 3px; }
  .brand-tag {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 9.5px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: #6b6b78;
    margin-top: 2px;
  }
  nav ul { display: flex; gap: 38px; list-style: none; margin: 0; padding: 0; align-items: center; }
  nav a {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    color: #3a3a45;
    font-weight: 500;
    letter-spacing: .01em;
    position: relative;
    padding: 6px 0;
    text-decoration: none;
  }
  nav a:hover { color: #201868; }
  nav a::after {
    content: ''; position: absolute; left: 0; bottom: 0; width: 0; height: 1px;
    background: #F07800; transition: width .3s ease;
  }
  nav a:hover::after, nav a[aria-current="page"]::after { width: 100%; }
  nav a[aria-current="page"] { color: #201868; font-weight: 600; }

  @media (max-width: 1080px) {
    .topbar-contact { display: none; }
    .topbar-inner { justify-content: flex-end; }
  }
  @media (max-width: 980px) {
    nav ul { gap: 24px; }
  }
  @media (max-width: 860px) {
    .bar { flex-direction: column; align-items: flex-start; gap: 12px; }
    nav ul { gap: 14px 20px; flex-wrap: wrap; }
    .brand-line { font-size: 20px; }
    .brand-tag { font-size: 8.5px; }
  }
</style>
<script is:inline>
  function googleTranslateElementInit(){new google.translate.TranslateElement({pageLanguage:'en'},'google_translate_element')}
</script>
<script is:inline defer src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
<script is:inline>
  (function(){var langs={"Afrikaans":"af","Albanian":"sq","Arabic":"ar","Bengali":"bn","Bulgarian":"bg","Chinese (Simplified)":"zh-CN","Chinese (Traditional)":"zh-TW","Croatian":"hr","Czech":"cs","Danish":"da","Dutch":"nl","English":"en","Estonian":"et","Filipino":"tl","Finnish":"fi","French":"fr","German":"de","Greek":"el","Gujarati":"gu","Hebrew":"iw","Hindi":"hi","Hungarian":"hu","Indonesian":"id","Italian":"it","Japanese":"ja","Kannada":"kn","Korean":"ko","Latvian":"lv","Lithuanian":"lt","Malay":"ms","Marathi":"mr","Norwegian":"no","Persian":"fa","Polish":"pl","Portuguese":"pt","Punjabi":"pa","Romanian":"ro","Russian":"ru","Serbian":"sr","Slovak":"sk","Slovenian":"sl","Spanish":"es","Swahili":"sw","Swedish":"sv","Tamil":"ta","Telugu":"te","Thai":"th","Turkish":"tr","Ukrainian":"uk","Urdu":"ur","Vietnamese":"vi"};var dl=document.getElementById("srj-langs");if(dl){Object.keys(langs).forEach(function(n){var o=document.createElement("option");o.value=n;dl.appendChild(o);});}var inp=document.getElementById("srj-lang-input");function combo(){return document.querySelector("select.goog-te-combo");}function apply(){if(!inp)return;var c=langs[inp.value];if(!c){return;}var tries=0;(function go(){var s=combo();if(s){s.value=c;s.dispatchEvent(new Event("change"));}else if(tries++<10){setTimeout(go,400);}})();}if(inp){inp.addEventListener("change",apply);}})();
</script>
<style is:global>
  .topbar-translate{display:inline-flex;align-items:center}
  .topbar-translate input{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.35);border-radius:5px;color:#fff;font:12.5px/1.5 inherit;padding:2px 9px;width:150px}
  .topbar-translate input::placeholder{color:rgba(255,255,255,.65)}
  .gt-hidden{position:absolute !important;left:-9999px;top:0;visibility:hidden}
  body{top:0 !important}.goog-te-banner-frame,#goog-gt-tt{display:none !important}
</style>
