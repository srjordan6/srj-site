---
// Primary navigation.
//
// Rebuilt 2026-07-30 to match the production WordPress header, from Stephen's
// screenshot of the live site rather than memory: a two-tier header. The navy
// topbar carries location, phone, email on the left and Search plus the
// consultation CTA on the right; the light main bar carries the serif
// wordmark with the library tagline and the nav links.
//
// Nav items are production's minus FAQ, removed on Stephen's instruction
// 2026-07-30 (the page still exists and stays linked from the footer).
//
// ONE DELIBERATE DEPARTURE FROM PRODUCTION. Resources points at /ai-resources/,
// not the /resources/ that WordPress links to. /resources/ is the legacy page,
// titled "Reference Material", whose only outbound link is the glossary.
// /ai-resources/ is the rebuilt hub that actually indexes the glossary, tools,
// people, news and everything-else sections. Matching production literally here
// would point the primary nav at the page the rebuild replaced.
//
// Home is reached through the brand mark, which is how production does it too.
// If this list changes, check it against the live site rather than editing from
// memory, because the failure is silent: the nav still renders, it is just wrong.
//
// SEARCH. The topbar Search button opens a panel backed by Pagefind, whose
// index is generated at build time (`pagefind --site dist`). The UI script and
// CSS load lazily on first open, so pages that never see a search pay nothing.
const nav = [
  { href: '/about/',        label: 'About' },
  { href: '/services/',     label: 'Services' },
  { href: '/applications/', label: 'Applications' },
  { href: '/industries/',   label: 'Industries' },
  { href: '/books/',        label: 'Books' },
  { href: '/ai-resources/', label: 'AI Resources' },
  { href: '/contact/',      label: 'Contact' },
];
const current = Astro.url.pathname;

const PHONE_DISPLAY = '(415) 413-7772';
const PHONE_TEL = '+14154137772';
const EMAIL = 'info@srjconsultingservices.com';
---
<header class="site-header">

  {/* Tier 1: navy topbar */}
  <div class="topbar">
    <div class="container topbar-inner">
      <div class="topbar-contact">
        {/* Language selection owns the topbar left, Stephen's July 31
            directive: a type-ahead input (datalist) driving a hidden Google
            Translate combo, replacing the unreadable stock widget. Phone and
            email removed from the topbar on the same instruction; they remain
            in the footer Contact column. */}
        <span class="topbar-translate notranslate" translate="no"><input id="srj-lang-input" value="English" autocomplete="off" role="combobox" aria-expanded="false" aria-label="Translate this page. All languages shown on click; type to filter" /><span class="lang-caret" aria-hidden="true">&#9662;</span><ul id="srj-lang-panel" class="lang-panel" hidden></ul><span id="google_translate_element" class="gt-hidden"></span></span>
      </div>
      <div class="topbar-actions">
        <button type="button" class="search-toggle" aria-expanded="false" aria-controls="srj-search-panel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" width="15" height="15">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.3" y2="16.3"></line>
          </svg>
          <span>Search</span>
        </button>
        <a class="topbar-cta" href="/schedule-consultation/">
          Schedule a Free AI Consultation <span class="arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  {/* Search panel sits between the tiers so it reads as part of the topbar */}
  <div id="srj-search-panel" class="search-panel" hidden>
    <div class="container">
      <div id="srj-search-box"></div>
      <p class="search-hint">Searches every page: governance library, books, services, glossary, tools, insights.</p>
    </div>
  </div>

  {/* Tier 2: main bar */}
  <div class="mainbar">
    <div class="container bar">
      <a class="brand" href="/">
        <span class="brand-line">SRJ Consulting <span class="amp">&amp;</span>Services</span>
        <span class="brand-tag">The Operating Discipline for AI Library&trade;</span>
      </a>
      <nav aria-label="Primary">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
      {/* Hamburger, mobile only. Same ids, classes, and behavior as the
          governance templates so the whole site opens one identical menu. */}
      <button class="srj-nav-toggle" id="srj-nav-toggle" type="button"
        aria-label="Open menu" aria-expanded="false" aria-controls="srj-mobile-panel">
        <span class="srj-nav-toggle-bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<div class="srj-mobile-scrim" id="srj-mobile-scrim"></div>
<nav class="srj-mobile-panel" id="srj-mobile-panel" aria-label="Mobile navigation" aria-hidden="true">
  <div class="srj-mobile-panel-head">
    <span class="srj-mobile-panel-label">Menu</span>
    <button class="srj-mobile-close" id="srj-mobile-close" type="button" aria-label="Close menu">&#215;</button>
  </div>
  <ul class="srj-mobile-links">
    {nav.map((n) => (
      <li><a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a></li>
    ))}
  </ul>
  <a href="/schedule-consultation/" class="srj-mobile-cta">Schedule a Free AI Consultation</a>
</nav>

<script is:inline>
(function () {
  var toggle = document.getElementById('srj-nav-toggle');
  var panel  = document.getElementById('srj-mobile-panel');
  var scrim  = document.getElementById('srj-mobile-scrim');
  var closeBtn = document.getElementById('srj-mobile-close');
  if (!toggle || !panel || !scrim) return;
  function setOpen(open) {
    panel.classList.toggle('is-open', open);
    scrim.classList.toggle('is-open', open);
    toggle.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    document.body.classList.toggle('srj-menu-open', open);
  }
  toggle.addEventListener('click', function () { setOpen(!panel.classList.contains('is-open')); });
  scrim.addEventListener('click', function () { setOpen(false); });
  if (closeBtn) closeBtn.addEventListener('click', function () { setOpen(false); });
  panel.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && panel.classList.contains('is-open')) setOpen(false);
  });
  window.addEventListener('resize', function () {
    if (window.innerWidth > 980 && panel.classList.contains('is-open')) setOpen(false);
  });
})();
</script>

<script is:inline>
// Lazy Pagefind. The index and UI assets live under /pagefind/ in the build
// output; nothing is fetched until the first open. Escape closes, and focus
// lands in the input on open.
(function () {
  var toggle = document.querySelector('.search-toggle');
  var panel = document.getElementById('srj-search-panel');
  if (!toggle || !panel) return;
  var loaded = false;

  function loadPagefind() {
    if (loaded) return Promise.resolve();
    loaded = true;
    return new Promise(function (resolve) {
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(css);
      var s = document.createElement('script');
      s.src = '/pagefind/pagefind-ui.js';
      s.onload = function () {
        /* global PagefindUI */
        new PagefindUI({
          element: '#srj-search-box',
          showSubResults: true,
          showImages: false,
          translations: { placeholder: 'Search srjconsultingservices.com' },
        });
        resolve();
      };
      s.onerror = function () {
        panel.querySelector('#srj-search-box').textContent =
          'Search could not load. Please try again, or browse from the navigation above.';
        resolve();
      };
      document.head.appendChild(s);
    });
  }

  function openPanel() {
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    loadPagefind().then(function () {
      var input = panel.querySelector('input');
      if (input) input.focus();
    });
  }
  function closePanel() {
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
  }

  toggle.addEventListener('click', function () {
    panel.hidden ? openPanel() : closePanel();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !panel.hidden) { closePanel(); toggle.focus(); }
  });
})();
</script>

<style>
  /* Values below are PRODUCTION'S OWN, lifted verbatim from the child theme
     stylesheet (srj-consulting style.css, mirrored in migrated-theme.css)
     after Stephen's July 30 screenshot showed this header drifting from the
     live site: wrong topbar shade (navy vs navy-deep), cream mainbar where
     production uses blurred paper-white, 27px/600 wordmark vs 25px/400,
     15.5px nav vs 14px, and a color-swap hover where production animates an
     orange underline. Literal hexes, not tokens, so a token edit cannot
     drift this chrome away from the WP original again. */
  /* display:contents dissolves the wrapper's box so the two tiers lay out as
     body-level children, which is what production has (announce and
     header.nav are siblings in <body>). Without this, .mainbar's sticky
     would be caged inside the wrapper's own height and stop sticking one
     header-height into the scroll. */
  .site-header { display: contents; }

  /* ---- tier 1: topbar (production .announce) ---- */
  .topbar { background: #1A1357; color: #fafaf6; padding: 11px 0; font-size: 13px; letter-spacing: .01em; }
  .topbar-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 30px; flex-wrap: wrap;
  }
  .topbar-contact { display: flex; align-items: center; gap: 24px; color: rgba(250,250,246,.78); font-family: 'Poppins', sans-serif; font-size: 12.5px; letter-spacing: .02em; }
  .topbar-loc { color: rgba(250,250,246,.55); }
  .topbar-dot { color: #F07800; font-size: 9px; }
  .topbar-contact a { color: rgba(250,250,246,.92); font-weight: 500; text-decoration: none; transition: color .2s ease; display: inline-flex; align-items: center; gap: 7px; }
  .topbar-contact a:hover { color: #F07800; }
  .topbar-actions { display: flex; align-items: center; gap: 22px; }
  .search-toggle {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 4px;
    color: #ffffff;
    font-family: 'Poppins', 'Open Sans', sans-serif;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    transition: background .15s ease, border-color .15s ease;
  }
  .search-toggle svg { display: block; width: 14px; height: 14px; }
  .search-toggle:hover, .search-toggle:focus-visible { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.45); outline: none; }
  .search-toggle[aria-expanded="true"] { background: #F07800; border-color: #F07800; color: #ffffff; }
  .topbar-cta {
    font-family: 'Poppins', sans-serif;
    font-size: 11.5px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #F07800;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: opacity .2s ease;
    white-space: nowrap;
  }
  .topbar-cta:hover { opacity: .75; }
  .topbar-cta .arrow { font-size: 14px; letter-spacing: 0; }

  /* ---- search panel ---- */
  .search-panel {
    background: #1A1357;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 22px 0 26px;
  }
  .search-hint { margin: 10px 0 0; font-size: 12.5px; color: rgba(255, 255, 255, 0.6); }
  /* Pagefind UI variables: brand it rather than shipping the default grey. */
  .search-panel :global(.pagefind-ui) {
    --pagefind-ui-primary: #F07800;
    --pagefind-ui-text: #ffffff;
    --pagefind-ui-background: #1A1357;
    --pagefind-ui-border: rgba(255, 255, 255, 0.25);
    --pagefind-ui-tag: #201868;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: 'Poppins', sans-serif;
  }
  .search-panel :global(.pagefind-ui__result-link) { color: #F07800; }
  .search-panel :global(.pagefind-ui__result-excerpt) { color: rgba(255, 255, 255, 0.8); }

  /* ---- tier 2: main bar (production header.nav) ---- */
  .mainbar {
    /* Production: the announce bar scrolls away; header.nav alone sticks. */
    position: sticky; top: 0; z-index: 100;
    background: rgba(250,250,246,.94);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid #e4e2dc;
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-top: 22px; padding-bottom: 22px; }
  .brand { display: flex; flex-direction: column; gap: 4px; line-height: 1; text-decoration: none; }
  .brand-line {
    font-family: 'Lora', serif;
    font-weight: 400;
    font-size: 25px;
    line-height: 1;
    color: #201868;
    letter-spacing: -0.01em;
  }
  .brand-line .amp { color: #F07800; font-style: italic; padding: 0 3px; }
  .brand-tag {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 9.5px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: #6b6b78;
    margin-top: 2px;
  }
  /* Scoped to the DESKTOP nav on purpose. The mobile panel is also a <nav>
     containing a <ul>, so a bare `nav ul` rule laid its seven links out in a
     38px-gapped row: two visible, five overflowing off-panel. */
  nav[aria-label="Primary"] ul { display: flex; gap: 38px; list-style: none; margin: 0; padding: 0; align-items: center; }
  nav a {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    color: #3a3a45;
    font-weight: 500;
    letter-spacing: .01em;
    position: relative;
    padding: 6px 0;
    text-decoration: none;
  }
  nav a:hover { color: #201868; }
  nav a::after {
    content: ''; position: absolute; left: 0; bottom: 0; width: 0; height: 1px;
    background: #F07800; transition: width .3s ease;
  }
  nav a:hover::after, nav a[aria-current="page"]::after { width: 100%; }
  nav a[aria-current="page"] { color: #201868; font-weight: 600; }

  @media (max-width: 1080px) {
    /* This used to hide .topbar-contact wholesale, from the era when it held
       phone and email. Since July 31 its only content is the language
       selector, which mobile visitors need most, so it compacts instead of
       disappearing (the bug: the selector simply did not exist below 1081px). */
    .topbar-contact { gap: 12px; }
    .topbar-translate input { width: 116px; font-size: 12px; }
  }
  @media (max-width: 640px) {
    /* The consultation CTA also lives in the hamburger panel, so on phones
       the topbar copy yields its space to the selector and search. */
    .topbar-cta { display: none; }
  }
  /* ---- hamburger + slide-in panel, visual twin of the governance pages ---- */
  .srj-nav-toggle { display: none; position: relative; z-index: 160; -webkit-appearance: none; appearance: none; background: transparent; border: 0; cursor: pointer; padding: 8px; margin: -8px; line-height: 0; }
  .srj-nav-toggle-bars { display: flex; flex-direction: column; justify-content: center; gap: 5px; width: 26px; height: 18px; }
  .srj-nav-toggle-bars span { display: block; width: 100%; height: 2px; border-radius: 2px; background: #201868; transition: transform .28s ease, opacity .18s ease, background .28s ease; }
  .srj-nav-toggle.is-open .srj-nav-toggle-bars span { background: #FFFFFF; }
  .srj-nav-toggle.is-open .srj-nav-toggle-bars span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .srj-nav-toggle.is-open .srj-nav-toggle-bars span:nth-child(2) { opacity: 0; }
  .srj-nav-toggle.is-open .srj-nav-toggle-bars span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .srj-mobile-scrim { position: fixed; inset: 0; z-index: 99998; background: rgba(16,12,52,.6); -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .3s ease, visibility .3s ease; }
  .srj-mobile-scrim.is-open { opacity: 1; visibility: visible; pointer-events: auto; }
  .srj-mobile-panel { position: fixed; top: 0; right: 0; z-index: 99999; display: flex; flex-direction: column; width: min(86vw, 380px); height: 100%; padding: 0 0 28px; background: #201868; box-shadow: -18px 0 50px rgba(0,0,0,.32); transform: translateX(100%); visibility: hidden; overflow-y: auto; -webkit-overflow-scrolling: touch; transition: transform .32s cubic-bezier(.4,0,.2,1), visibility .32s ease; }
  .srj-mobile-panel.is-open { transform: translateX(0); visibility: visible; }
  .srj-mobile-panel-head { display: flex; align-items: center; justify-content: space-between; padding: 26px 26px 18px; border-bottom: 1px solid rgba(255,255,255,.12); }
  .srj-mobile-panel-label { font-family: 'Poppins', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: rgba(255,255,255,.5); }
  .srj-mobile-close { -webkit-appearance: none; appearance: none; background: transparent; border: 0; cursor: pointer; color: #FFFFFF; font-size: 30px; line-height: 1; padding: 0 4px; margin: -6px -6px -6px 0; transition: color .18s ease; }
  .srj-mobile-close:hover { color: #F07800; }
  .srj-mobile-close:focus-visible { outline: 2px solid #F07800; outline-offset: 3px; }
  .srj-mobile-links { display: block; flex: 1; list-style: none; margin: 0; padding: 12px 0; }
  .srj-mobile-links li { margin: 0; }
  .srj-mobile-links a { display: block; padding: 14px 26px; border-left: 3px solid transparent; font-family: 'Poppins', sans-serif; font-size: 16px; font-weight: 500; letter-spacing: .01em; color: rgba(255,255,255,.85); transition: color .18s ease, background .18s ease, border-color .18s ease; }
  .srj-mobile-links a:hover { color: #FFFFFF; background: rgba(255,255,255,.06); border-left-color: #F07800; }
  .srj-mobile-links a[aria-current="page"] { color: #F07800; background: rgba(240,120,0,.10); border-left-color: #F07800; }
  .srj-mobile-links a::after { display: none; }
  .srj-mobile-cta { display: block; margin: 16px 26px 0; padding: 15px 18px; background: #F07800; color: #201868; font-family: 'Poppins', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; text-align: center; transition: background .2s ease; }
  .srj-mobile-cta:hover { background: #ff8c1a; color: #201868; }
  .srj-nav-toggle:focus-visible, .srj-mobile-links a:focus-visible, .srj-mobile-cta:focus-visible { outline: 2px solid #F07800; outline-offset: 3px; }

  @media (max-width: 980px) {
    nav[aria-label="Primary"] { display: none; }
    .srj-nav-toggle { display: block; }
    .bar { gap: 16px; }
  }
  @media (max-width: 860px) {
    .brand-line { font-size: 20px; }
    .brand-tag { font-size: 8.5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .srj-mobile-panel, .srj-mobile-scrim, .srj-nav-toggle-bars span { transition: none; }
  }
</style>
<script is:inline>
  function googleTranslateElementInit(){new google.translate.TranslateElement({pageLanguage:'en'},'google_translate_element')}
</script>
<script is:inline defer src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
<script is:inline>
  (function(){var langs={"English":"en","Afrikaans":"af","Albanian":"sq","Arabic":"ar","Bengali":"bn","Bulgarian":"bg","Chinese (Simplified)":"zh-CN","Chinese (Traditional)":"zh-TW","Croatian":"hr","Czech":"cs","Danish":"da","Dutch":"nl","Estonian":"et","Filipino":"tl","Finnish":"fi","French":"fr","German":"de","Greek":"el","Gujarati":"gu","Hebrew":"iw","Hindi":"hi","Hungarian":"hu","Indonesian":"id","Italian":"it","Japanese":"ja","Kannada":"kn","Korean":"ko","Latvian":"lv","Lithuanian":"lt","Malay":"ms","Marathi":"mr","Norwegian":"no","Persian":"fa","Polish":"pl","Portuguese":"pt","Punjabi":"pa","Romanian":"ro","Russian":"ru","Serbian":"sr","Slovak":"sk","Slovenian":"sl","Spanish":"es","Swahili":"sw","Swedish":"sv","Tamil":"ta","Telugu":"te","Thai":"th","Turkish":"tr","Ukrainian":"uk","Urdu":"ur","Vietnamese":"vi"};var inp=document.getElementById("srj-lang-input");var panel=document.getElementById("srj-lang-panel");if(!inp||!panel)return;var names=Object.keys(langs);function combo(){return document.querySelector("select.goog-te-combo");}function choose(n){inp.value=n;panel.hidden=true;inp.setAttribute("aria-expanded","false");var c=langs[n];if(!c)return;if(c==="en"){document.cookie="googtrans=;path=/;max-age=0";document.cookie="googtrans=;path=/;domain=."+location.hostname+";max-age=0";location.reload();return;}var tries=0;(function go(){var s=combo();if(s){s.value=c;s.dispatchEvent(new Event("change"));}else if(tries++<10){setTimeout(go,400);}})();}function render(f){panel.innerHTML="";var q=(f||"").toLowerCase();var list=["English"].concat(names.filter(function(n){return n!=="English"&&(!q||n.toLowerCase().indexOf(q)>-1);}));list.forEach(function(n){var li=document.createElement("li");li.textContent=n;if(n==="English"){li.className="en";}li.addEventListener("mousedown",function(e){e.preventDefault();choose(n);});panel.appendChild(li);});}function show(f){render(f);panel.hidden=false;inp.setAttribute("aria-expanded","true");}inp.addEventListener("focus",function(){inp.select();show("");});inp.addEventListener("click",function(){show("");});inp.addEventListener("input",function(){show(inp.value);});inp.addEventListener("blur",function(){setTimeout(function(){panel.hidden=true;inp.setAttribute("aria-expanded","false");},160);});inp.addEventListener("keydown",function(e){if(e.key==="Enter"){e.preventDefault();var q=inp.value.toLowerCase();var m=names.filter(function(n){return n.toLowerCase().indexOf(q)>-1;})[0];if(m){choose(m);}}else if(e.key==="Escape"){panel.hidden=true;}});})();
</script>
<style is:global>
  .topbar-translate{display:inline-flex;align-items:center;position:relative}
  .lang-caret{color:rgba(255,255,255,.75);margin-left:-20px;pointer-events:none;font-size:11px;position:relative;z-index:2}
  .lang-panel{position:absolute;top:calc(100% + 5px);left:0;z-index:1200;background:#1A1357;border:1px solid rgba(255,255,255,.25);border-radius:6px;max-height:320px;overflow:auto;width:215px;margin:0;padding:4px 0;list-style:none;box-shadow:0 8px 24px rgba(0,0,0,.35)}
  .lang-panel li{padding:5px 13px;color:#fff;font-size:12.5px;cursor:pointer}
  .lang-panel li:hover{background:#F07800}
  .lang-panel li.en{font-weight:700}
  .topbar-translate input{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.35);border-radius:5px;color:#fff;font-weight:700;font-size:12.5px;line-height:1.5;font-family:inherit;padding:2px 9px;width:150px}
  .topbar-translate input::placeholder{color:rgba(255,255,255,.65)}
  .gt-hidden{position:absolute !important;left:-9999px;top:0;visibility:hidden}
  body{top:0 !important;position:static !important}.goog-te-banner-frame,#goog-gt-tt,iframe.skiptranslate{display:none !important}
  /* The topbar carries Search and the language selector; it stays pinned so
