---
// One route, two page kinds, at /ai-resources/ai-tools/{slug}/.
//
// WHY THEY SHARE A FILE. Categories and tools sit at the same URL depth, and
// Astro cannot carry two dynamic routes at one depth without ambiguity. Rather
// than push categories down to /ai-tools/category/{slug}/, which is worse for
// both readers and search, getStaticPaths emits both kinds and the template
// branches on kind. Tool URLs are unchanged by this, which matters because 63
// of them are already live and indexed.
//
// TOOL PAGES exist only where a researched profile exists. The catalog lists
// all 320; the profiled ones become internal links and the rest keep pointing
// at the vendor's own product page. 320 pages carrying four real fields each
// would be thin content, an SEO liability rather than an asset.
//
// CATEGORY PAGES exist for all 23, because a category page is never thin: it
// carries a real list of real tools, and the list is the content.
//
// Every field is optional in the render. An absent field does not appear,
// rather than showing an empty row or a plausible guess.
//
// NOTE ON COMPLIANCE CLAIMS: certifications render only when supplied in the
// data. None of the profiles asserts SOC 2, ISO 27001, or HIPAA status, because
// those are per-vendor per-date facts and a compliance practice publishing a
// wrong one about a named vendor is a different class of error from a typo.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FreeAIResources from '../../../components/FreeAIResources.astro';
import { faqPage, itemList, collectionPage } from '../../../lib/pageSchema';
import profileDoc from '../../../content/resources/tool-profiles.json';
import catalog from '../../../content/resources/tools.json';
import boardDoc from '../../../content/leaderboard/leaderboard.json';

const slugify = (s: string) =>
  s.replace(/&/g, ' and ').replace(/[^\w\s-]/g, '').trim().toLowerCase().replace(/[\s_-]+/g, '-');

// Which arena.ai boards belong on which category page. A leaderboard is only
// shown where the models on it are the things the category is about. Putting
// the text board on the video-editing page would be filler.
const BOARDS_FOR: Record<string, string[]> = {
  'chat-and-general-llms': ['text', 'agent', 'vision', 'search'],
  'coding-and-developer-tools': ['code'],
  'chinese-foundation-models': ['text', 'code'],
  'cloud-ai-services-and-model-apis': ['text'],
  'open-source-and-self-hosted-models': ['text', 'code'],
};

export async function getStaticPaths() {
  const doc: any = profileDoc;
  const tools: any = catalog;
  const rows = tools.tools ?? [];

  const slugFor = (s: string) =>
    s.replace(/&/g, ' and ').replace(/[^\w\s-]/g, '').trim().toLowerCase().replace(/[\s_-]+/g, '-');

  const toolPaths = Object.entries(doc.profiles ?? {}).map(([slug, p]: [string, any]) => {
    const row = rows.find((t: any) => t.name === p.catalog_name) ?? null;
    return {
      params: { slug },
      props: { kind: 'tool', slug, p, row, asOf: doc.as_of, caveat: doc.caveat },
    };
  });

  // A tool slug and a category slug colliding would silently drop one page.
  // Assert rather than hope: category slugs are multi-word and tool slugs are
  // product names, so a collision means a data change worth stopping for.
  const taken = new Set(toolPaths.map((t) => t.params.slug));

  const categories = [...new Set(rows.map((t: any) => t.category))].sort() as string[];
  const catPaths = categories.map((name) => {
    const slug = slugFor(name);
    if (taken.has(slug)) {
      throw new Error(
        `Category "${name}" slugifies to "${slug}", which is already a tool page. ` +
        `One of the two would be dropped silently. Rename before shipping.`
      );
    }
    const members = rows
      .filter((t: any) => t.category === name)
      .sort((a: any, b: any) => a.name.toLowerCase().localeCompare(b.name.toLowerCase()));
    return {
      params: { slug },
      props: { kind: 'category', slug, catName: name, members, asOf: doc.as_of },
    };
  });

  return [...toolPaths, ...catPaths];
}

const props = Astro.props as any;
const { kind, slug } = props;

const SITE = 'https://srjconsultingservices.com';
const url = `${SITE}/ai-resources/ai-tools/${slug}/`;
const has = (x: any) => (Array.isArray(x) ? x.length > 0 : Boolean(x));

// Profile lookup shared by both kinds: the category page needs to know which of
// its members have a profile so it can link internally rather than off-site.
const allProfiles: Record<string, any> = (profileDoc as any).profiles ?? {};
const profileSlugBy: Record<string, string> = Object.fromEntries(
  Object.entries(allProfiles).map(([s, p]: [string, any]) => [p.catalog_name, s])
);

// ---------------------------------------------------------------- CATEGORY
const catName: string = props.catName ?? '';
const members: any[] = props.members ?? [];
const boards = (boardDoc as any).boards ?? [];
const myBoards = kind === 'category' ? boards.filter((b: any) => (BOARDS_FOR[slug] ?? []).includes(b.key)) : [];
const lbDate = (boardDoc as any).date ?? '';
const lbMethod = (boardDoc as any).method ?? '';
const lbSourceUrl = (boardDoc as any).source_url ?? '';
const lbSource = (boardDoc as any).source ?? '';

const memberProfiled = members.filter((m) => profileSlugBy[m.name]).length;
const memberVendors = [...new Set(members.map((m) => m.vendor))];
const memberJur = [...new Set(members.map((m) => m.jurisdiction))];

const allCats = [...new Set(((catalog as any).tools ?? []).map((t: any) => t.category))].sort() as string[];

// Titles and descriptions are generated, so they are checked against the SEO
// limits for every category rather than eyeballed on one. Three category names
// are long enough that the full title form overruns 60 characters, so those
// fall back to a short form instead of being truncated mid-word.
//
// catName is never lowercased. "Chat & General LLMs".toLowerCase() yields
// "chat & general llms", which turns an acronym into a typo on 42 pages.
const catFullTitle = `${catName}: ${members.length} Tools Compared | SRJ`;
const catTitle = catFullTitle.length <= 60 ? catFullTitle : `${catName} Tools | SRJ`;

// Meta descriptions have to land in 150-160 characters across 23 category names
// that vary from "Voice & Audio" to "Enterprise AI Platforms & Agent
// Orchestration", a 32-character spread before the tool count is added. A single
// template cannot do that: a fixed phrase that fits the short names runs over on
// the long ones, and padding the short ones overruns the long ones further.
//
// So the phrasing is chosen rather than fixed. Several equivalent openings and
// closings are declared, the fullest combination that lands inside the window
// wins, and if nothing fits the closest is used. Every variant says the same
// thing; only the length differs. This is checked for all 23 before shipping,
// because the failure is invisible on any single page.
const catDescBases = [
  `All ${members.length} ${catName} tools, each with its vendor, home jurisdiction, and the governance question it raises`,
  `All ${members.length} ${catName} tools with vendor, home jurisdiction, and the governance question each raises`,
  `All ${members.length} ${catName} tools with vendor, jurisdiction, and the governance question each raises`,
  `All ${members.length} ${catName} tools with vendor, jurisdiction, and the governance question raised`,
  `All ${members.length} ${catName} tools with vendor, jurisdiction, and governance notes`,
  `All ${members.length} ${catName} tools with vendor and jurisdiction`,
];
const catDescTails = myBoards.length
  ? [
      `, plus live arena.ai model rankings, refreshed daily from the source.`,
      `, plus live arena.ai model rankings refreshed daily.`,
      `, plus live model rankings refreshed daily.`,
      `, plus live arena.ai rankings.`,
    ]
  : [
      `, on the SRJ inventory checklist for AI governance, audit, and procurement work.`,
      `, on the SRJ inventory checklist for AI governance and audit work.`,
      `, on the SRJ AI tool inventory checklist for governance work.`,
      `, on the SRJ AI tool inventory checklist.`,
      `, for the SRJ AI tool inventory.`,
      `.`,
    ];
const catDescCandidates = catDescBases.flatMap((b) => catDescTails.map((t) => b + t));
const catDescFitting = catDescCandidates.filter((d) => d.length >= 150 && d.length <= 160);
const catDesc = catDescFitting.length
  ? catDescFitting.reduce((a, b) => (b.length > a.length ? b : a))
  : catDescCandidates.reduce((a, b) =>
      Math.min(Math.abs(b.length - 150), Math.abs(b.length - 160)) <
      Math.min(Math.abs(a.length - 150), Math.abs(a.length - 160))
        ? b
        : a
    );

const catFaqs = kind !== 'category' ? [] : [
  {
    q: `How many ${catName} tools are there?`,
    a: `This catalog lists ${members.length} tools in the ${catName} category, from ` +
       `${memberVendors.length} vendors across ${memberJur.length} jurisdictions. ` +
       `${memberProfiled} carry a full SRJ profile; the rest link to the vendor's own product page.`,
  },
  ...(myBoards.length
    ? [{
        q: `Which model ranks highest right now?`,
        a: `On the ${myBoards[0].label.toLowerCase()} board at ${lbSource}, as of ${lbDate}, the ` +
           `leader is ${myBoards[0].models[0].model}` +
           (myBoards[0].models[0].vendor ? ` from ${myBoards[0].models[0].vendor}` : ``) +
           (myBoards[0].scored ? ` on ${Math.round(myBoards[0].models[0].score)} Elo` : ``) +
           `. Rankings move weekly, so the table on this page is refreshed from the source ` +
           `automatically rather than typed by hand. Read the confidence intervals before treating ` +
           `a small gap as a difference.`,
      },
      {
        q: `Do benchmark rankings tell you which model to buy?`,
        a: `No. A leaderboard measures average preference across a crowd of prompts that are not ` +
           `your prompts. It says nothing about your data terms, your jurisdiction, your latency ` +
           `budget, or your integration surface, and those usually decide procurement. Use the ` +
           `rankings to shortlist, then evaluate on your own workload against your own governance ` +
           `requirements.`,
      }]
    : []),
  {
    q: `Does inclusion in this category mean SRJ recommends the tool?`,
    a: `No. This is a reference catalog, not an endorsement list. Presence here means only that a ` +
       `tool is common enough in the field that it belongs on an inventory checklist. It is not a ` +
       `security review, a due-diligence result, or a recommendation to buy.`,
  },
  {
    q: `Why does the catalog list each vendor's home jurisdiction?`,
    a: `Jurisdiction is a governance fact. Where a vendor is based determines which data-transfer, ` +
       `privacy, and cross-border rules apply before any business data reaches the tool. Two tools ` +
       `that look identical in features can carry very different obligations once the vendor's home ` +
       `country is taken into account. This category spans ${memberJur.length} jurisdictions.`,
  },
];

// ---------------------------------------------------------------- TOOL
const p = props.p;
const row = props.row;
const asOf = props.asOf;
const caveat = props.caveat;

const toolTitle = kind === 'tool' ? `${p.name} Review: Features, Pricing & Governance | SRJ`.slice(0, 62) : '';
const toolDesc = kind === 'tool'
  ? `${p.name} by ${p.vendor}: what it does, what it runs on, how it is priced, ` +
    `what it is good and bad at, and the governance questions it raises.`
  : '';

const toolFaqs = kind !== 'tool' ? [] : [
  { q: `What is ${p.name} used for?`, a: p.value },
  ...(p.engine ? [{ q: `What model does ${p.name} run on?`, a: p.engine }] : []),
  ...(p.training_optout ? [{ q: `Does ${p.name} train on your data?`, a: p.training_optout }] : []),
  ...(p.alternatives?.length
    ? [{ q: `What are the alternatives to ${p.name}?`,
         a: `The closest comparable tools are ${p.alternatives.join(', ')}. Which fits depends on ` +
            `where the work already lives and what the organization's data terms require.` }]
    : []),
];

// ---------------------------------------------------------------- SHARED
const title = kind === 'category' ? catTitle : toolTitle;
const description = kind === 'category' ? catDesc : toolDesc;
const faqs = kind === 'category' ? catFaqs : toolFaqs;
const crumbName = kind === 'category' ? catName : p.name;

// Tool crumbs now pass through the category, which is the hierarchy a reader
// actually navigates even though the URLs are flat.
const crumbs = kind === 'category'
  ? [
      { name: 'Home', url: '/' },
      { name: 'AI Resources', url: '/ai-resources/' },
      { name: 'AI Tools', url: '/ai-resources/ai-tools/' },
      { name: catName },
    ]
  : [
      { name: 'Home', url: '/' },
      { name: 'AI Resources', url: '/ai-resources/' },
      { name: 'AI Tools', url: '/ai-resources/ai-tools/' },
      ...(row?.category
        ? [{ name: row.category, url: `/ai-resources/ai-tools/${slugify(row.category)}/` }]
        : []),
      { name: p.name },
    ];

const schema = kind === 'category'
  ? [
      collectionPage({ url, name: catName, description: catDesc }),
      itemList({
        url, name: `${catName} tools`, description: catDesc,
        items: members.map((m) => ({
          name: m.name,
          url: profileSlugBy[m.name] ? `${SITE}/ai-resources/ai-tools/${profileSlugBy[m.name]}/` : (m.url || undefined),
          description: `${m.vendor}, ${m.jurisdiction}. ${m.note}`,
        })),
      }),
      ...myBoards.map((b: any) => itemList({
        url: `${url}#board-${b.key}`,
        name: `${b.label} ranking, ${lbSource}, ${lbDate}`,
        description: b.note,
        items: b.models.map((m: any) => ({
          name: m.model,
          description: [m.vendor, b.scored ? `${Math.round(m.score)} Elo` : null]
            .filter(Boolean).join(' — '),
        })),
      })),
      faqPage(url, catFaqs),
    ]
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        '@id': `${url}#software`,
        name: p.name,
        applicationCategory: row?.category ?? 'BusinessApplication',
        description: p.value,
        url: row?.url || undefined,
        author: { '@type': 'Organization', name: p.vendor },
        publisher: { '@id': `${SITE}/#organization` },
        ...(p.tags?.length ? { keywords: p.tags.join(', ') } : {}),
        ...(p.pricing?.length
          ? { offers: p.pricing.map((t: any) => ({
              '@type': 'Offer', name: t.tier, description: `${t.model}. ${t.includes}`,
            })) }
          : {}),
      },
      faqPage(url, toolFaqs),
    ];

const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
---
<BaseLayout title={title} description={description} schema={schema} crumbName={crumbName} crumbs={crumbs}>

{kind === 'category' ? (
  <>
  <section class="hero">
    <div class="container">
      <p class="vendor">AI Tools</p>
      <h1>{catName}</h1>
      <p class="tagline">
        Every {catName} tool in the catalog, with its vendor, home jurisdiction,
        and the governance question it raises.
      </p>
      <p class="stamp">
        {members.length} tools · {memberVendors.length} vendors · {memberJur.length} jurisdictions
        {memberProfiled > 0 && <> · {memberProfiled} full profiles</>}
      </p>
    </div>
  </section>

  <section class="body">
    <div class="container">

      <div class="answer">
        <p class="answer-label">In short</p>
        <p>
          {catName} covers {members.length} tools from {memberVendors.length} vendors
          across {memberJur.length} jurisdictions. {memberProfiled > 0
            ? `${memberProfiled} carry a full SRJ profile covering pricing tiers, data terms, and the governance question the tool raises; the rest link to the vendor's own product page.`
            : `Each links to the vendor's own product page.`}
          {myBoards.length > 0
            ? ` Live model rankings from ${lbSource} sit below, refreshed from the source rather than typed by hand.`
            : ``}
          This is a reference list to inventory against, not a recommendation to buy.
        </p>
      </div>

      {myBoards.length > 0 && (
        <section class="lb" id="leaderboard">
          <h2>Current model rankings</h2>
          <div class="rule"></div>

          <p class="lb-intro">
            Rankings below come from <a href={lbSourceUrl} target="_blank" rel="noopener">{lbSource}</a>,
            fetched automatically and stamped with the date they were true. Model leaderboards move
            weekly, so any figure typed into a page by hand is wrong within days. These are not.
          </p>

          <div class="lb-meta">
            <span class="lb-date">As of {lbDate}</span>
            <span class="lb-src">Source: {lbSource}</span>
          </div>

          <div class="warn">
            <p class="warn-label">Read this before reading the tables</p>
            <p>{lbMethod}</p>
          </div>

          {myBoards.map((b: any) => (
            <div class="board" id={`board-${b.key}`}>
              <h3>{b.label}</h3>
              <p class="board-note">{b.note}</p>
              <div class="tablewrap">
                <table class="lbt">
                  <thead>
                    <tr>
                      <th class="c-rank">#</th>
                      <th>Model</th>
                      <th>Vendor</th>
                      {b.scored && <th class="c-num">Rating</th>}
                      {b.scored && <th class="c-num">± 95% CI</th>}
                    </tr>
                  </thead>
                  <tbody>
                    {b.models.map((m: any) => (
                      <tr>
                        <td class="c-rank">{m.rank}</td>
                        <td class="m-name">{m.model}</td>
                        <td class="m-vendor">{m.vendor ?? '—'}</td>
                        {b.scored && <td class="c-num">{m.score != null ? fmt(m.score) : '—'}</td>}
                        {b.scored && <td class="c-num ci">{m.ci != null ? `± ${fmt(m.ci)}` : '—'}</td>}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="board-foot">
                Top {b.models.length} of {b.count} ranked.
                {!b.scored && <> This board is published as an order only, with no ratings, so no rating column is shown rather than one being invented.</>}
                {' '}<a href={b.source_url} target="_blank" rel="noopener">Full board at {lbSource} &rarr;</a>
              </p>
            </div>
          ))}

          <p class="caveat">
            A leaderboard measures average preference across a crowd of prompts that are not your
            prompts. It says nothing about your data terms, your jurisdiction, your latency budget,
            or your integration surface, and those usually decide procurement. Use it to shortlist,
            then evaluate on your own workload. Benchmarks beyond these boards, including MMLU-Pro,
            SWE-bench Verified, GPQA Diamond, and throughput figures, are deliberately not reproduced
            here: no verified machine-readable source for them is wired up yet, and an unsourced
            number on this site would be worse than a missing one.
          </p>
        </section>
      )}

      <section class="listing">
        <h2>All {members.length} {catName} tools</h2>
        <div class="rule"></div>
        <ul class="tools">
          {members.map((m) => (
            <li>
              <span class="tool">
                {profileSlugBy[m.name] ? (
                  <a href={`/ai-resources/ai-tools/${profileSlugBy[m.name]}/`}>{m.name}</a>
                ) : m.url ? (
                  <a href={m.url} rel="noopener" target="_blank">{m.name}</a>
                ) : (
                  m.name
                )}
              </span>
              {profileSlugBy[m.name] && <span class="badge">Profile</span>}
              <span class="vendor-inline">{m.vendor}, {m.jurisdiction}</span>
              <span class="note-inline">{m.note}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="faq">
        <h2>Frequently asked questions</h2>
        <div class="rule"></div>
        {catFaqs.map((f) => (
          <div class="faq-item"><h3>{f.q}</h3><p>{f.a}</p></div>
        ))}
      </section>

      <section class="siblings">
        <h2>Other categories</h2>
        <div class="rule"></div>
        <nav class="cats" aria-label="Other tool categories">
          {allCats.filter((c) => c !== catName).map((c) => (
            <a href={`/ai-resources/ai-tools/${slugify(c)}/`}>{c}</a>
          ))}
        </nav>
        <p class="back"><a href="/ai-resources/ai-tools/">&larr; Back to the full catalog</a></p>
      </section>

      <div class="cta">
        <h2>You cannot govern what you have not listed</h2>
        <p>
          The AI Business Enablement Audit&trade; builds the inventory, measures your organization
          against every framework in the
          <a href="/ai-governance/"> AI Governance Reference Library</a>, and delivers a defensible
          governance dossier.
        </p>
        <a class="btn-cta" href="https://aiauditforcompanies.com/startaiaudit/" target="_blank" rel="noopener">
          Start or finish your AI Audit &rarr;
        </a>
      </div>
    </div>
  </section>
  </>
) : (
  <>
  <section class="hero">
    <div class="container">
      <p class="vendor">{p.vendor}</p>
      <h1>{p.name}</h1>
      <p class="tagline">{p.tagline}</p>
      <div class="pills">
        {row?.category && <a class="pill pill-cat" href={`/ai-resources/ai-tools/${slugify(row.category)}/`}>{row.category}</a>}
        {p.status && <span class="pill">{p.status}</span>}
        {(p.tags ?? []).map((t: string) => <span class="pill pill-tag">#{t.replace(/\s+/g, '')}</span>)}
      </div>
    </div>
  </section>

  <section class="body">
    <div class="container cols">

      <aside class="side">
        <div class="panel sticky">
          <p class="box-label">Quick specs</p>
          <table class="spec">
            <tbody>
              <tr><th scope="row">Developer</th><td>{p.vendor}</td></tr>
              {row?.jurisdiction && <tr><th scope="row">Jurisdiction</th><td>{row.jurisdiction}</td></tr>}
              {row?.category && <tr><th scope="row">Category</th><td><a href={`/ai-resources/ai-tools/${slugify(row.category)}/`}>{row.category}</a></td></tr>}
              {p.status && <tr><th scope="row">Status</th><td>{p.status}</td></tr>}
              {has(p.access) && <tr><th scope="row">Access</th><td>{p.access.join(', ')}</td></tr>}
              {p.engine && <tr><th scope="row">Engine</th><td>{p.engine}</td></tr>}
              {p.latency && <tr><th scope="row">Speed</th><td>{p.latency}</td></tr>}
              {p.api && <tr><th scope="row">API</th><td>{p.api}</td></tr>}
            </tbody>
          </table>
          {row?.url && (
            <a class="btn" href={row.url} target="_blank" rel="noopener">Visit {p.name} &rarr;</a>
          )}
          <p class="asof">Profile current as of {asOf}. Verify pricing and certifications with the vendor.</p>
        </div>
        <FreeAIResources current="tools" />
      </aside>

      <div class="main">
        <div class="answer">
          <p class="answer-label">In short</p>
          <p>{p.value}</p>
        </div>

        {has(p.use_cases) && (
          <section id="use-cases">
            <h2>What it is best at</h2><div class="rule"></div>
            <ol class="cases">{p.use_cases.map((c: string) => <li>{c}</li>)}</ol>
            {has(p.audience) && <p class="aud"><strong>Built for:</strong> {p.audience.join(' · ')}</p>}
          </section>
        )}

        {(p.engine || p.files || p.quality) && (
          <section id="technical">
            <h2>Technical foundation</h2><div class="rule"></div>
            <dl class="defs">
              {p.engine && <><dt>Base model</dt><dd>{p.engine}</dd></>}
              {p.files && <><dt>Context and file handling</dt><dd>{p.files}</dd></>}
              {p.latency && <><dt>Latency</dt><dd>{p.latency}</dd></>}
              {p.quality && <><dt>Output quality and limits</dt><dd>{p.quality}</dd></>}
            </dl>
          </section>
        )}

        {has(p.pricing) && (
          <section id="pricing">
            <h2>Pricing and access tiers</h2><div class="rule"></div>
            <div class="tablewrap">
              <table class="tiers">
                <thead><tr><th>Tier</th><th>Model</th><th>Key inclusions</th><th>Limits</th></tr></thead>
                <tbody>
                  {p.pricing.map((t: any) => (
                    <tr><td class="tname">{t.tier}</td><td>{t.model}</td><td>{t.includes}</td><td>{t.limits}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="caveat">{caveat}</p>
          </section>
        )}

        {(p.training_optout || p.governance_note || has(p.compliance) || p.retention) && (
          <section id="governance">
            <h2>Security, privacy and governance</h2><div class="rule"></div>
            <dl class="defs">
              {p.training_optout && <><dt>Training data opt-out</dt><dd>{p.training_optout}</dd></>}
              {has(p.compliance) && <><dt>Compliance and certifications</dt><dd>{p.compliance.join(', ')}</dd></>}
              {p.retention && <><dt>Data retention</dt><dd>{p.retention}</dd></>}
            </dl>
            {p.governance_note && (
              <div class="gov">
                <p class="gov-label">The governance question this raises</p>
                <p>{p.governance_note}</p>
              </div>
            )}
            {!has(p.compliance) && (
              <p class="caveat">
                No compliance certifications are listed here. Certification status is
                vendor-specific and time-specific, so it is stated only where verified rather
                than assumed. Check the vendor&rsquo;s trust centre and confirm it covers the
                specific tier you are buying.
              </p>
            )}
          </section>
        )}

        {(has(p.integrations) || p.api) && (
          <section id="integrations">
            <h2>Integrations and ecosystem</h2><div class="rule"></div>
            {has(p.integrations) && <ul class="bul">{p.integrations.map((i: string) => <li>{i}</li>)}</ul>}
            {p.api && <p class="api"><strong>API and SDKs:</strong> {p.api}</p>}
          </section>
        )}

        {(has(p.pros) || has(p.cons) || has(p.alternatives)) && (
          <section id="verdict">
            <h2>The verdict</h2><div class="rule"></div>
            <div class="pc">
              {has(p.pros) && (
                <div class="pcol pros"><p class="pc-label">Strengths</p>
                  <ul>{p.pros.map((x: string) => <li>{x}</li>)}</ul></div>
              )}
              {has(p.cons) && (
                <div class="pcol cons"><p class="pc-label">Drawbacks</p>
                  <ul>{p.cons.map((x: string) => <li>{x}</li>)}</ul></div>
              )}
            </div>
            {has(p.alternatives) && (
              <p class="alts"><strong>Consider instead:</strong> {p.alternatives.join(', ')}</p>
            )}
          </section>
        )}

        <section id="faq">
          <h2>Frequently asked questions</h2><div class="rule"></div>
          {toolFaqs.map((f) => (
            <div class="faq-item"><h3>{f.q}</h3><p>{f.a}</p></div>
          ))}
        </section>

        <div class="cta">
          <h2>Listing a tool is not governing it</h2>
          <p>
            The AI Business Enablement Audit&trade; builds the inventory, measures your organization
            against every framework in the
            <a href="/ai-governance/"> AI Governance Reference Library</a>, and delivers a defensible
            governance dossier.
          </p>
          <a class="btn-cta" href="https://aiauditforcompanies.com/startaiaudit/" target="_blank" rel="noopener">
            Start or finish your AI Audit &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>
  </>
)}
</BaseLayout>

