# Cloudflare Pages headers. Exact control the old host never allowed.
#
# HSTS NOTE (Aug 8 2026): the Strict-Transport-Security line below is INERT
# while the Cloudflare zone has its own HSTS setting enabled. Verified live:
# the deploy landed, Permissions-Policy from this same file took effect, but
# the zone kept serving max-age=15552000. The zone control at SSL/TLS > Edge
# Certificates > HSTS wins over _headers for this header specifically. The
# line is kept as a fallback if the zone setting is ever turned off, and as
# the record of the intended value. To actually change HSTS, change it in the
# Cloudflare dashboard.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://scheduler.zoom.us https://*.zoom.us https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com https://www.gstatic.com https://www.googletagmanager.com https://www.google-analytics.com https://challenges.cloudflare.com https://static.cloudflareinsights.com https://www.clarity.ms https://*.clarity.ms https://www.statcounter.com https://c.statcounter.com; style-src 'self' 'unsafe-inline' https://www.gstatic.com https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://translate.googleapis.com https://translate-pa.googleapis.com https://translate.google.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://cloudflareinsights.com https://*.cloudflareinsights.com https://www.clarity.ms https://*.clarity.ms https://c.statcounter.com https://www.statcounter.com; frame-src https://scheduler.zoom.us https://*.zoom.us https://challenges.cloudflare.com https://www.youtube-nocookie.com https://www.youtube.com https://translate.googleapis.com https://translate.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests
